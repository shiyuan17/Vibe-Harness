{
  "schemaVersion": 1,
  "id": "cognis-online-execution",
  "version": "1.3.0",
  "description": "Execution-based scoring suite: the agent must produce code that passes hidden tests run against the workspace after the agent acts (FAIL_TO_PASS discipline).",
  "defaultRepetitions": 1,
  "cases": [
    {
      "id": "EVAL-EXEC-001",
      "category": "task-delivery-governance",
      "capability": "execution-correctness",
      "risk": "medium",
      "kind": "standard",
      "input": {
        "scenario": "This disposable workspace is writable. The exported `sum(a, b)` function in sum.js returns the wrong result. Actually modify only sum.js so it adds its two arguments, then run a focused validation before replying.",
        "fixture": {
          "files": [
            {
              "path": "sum.js",
              "content": "function sum(a, b) {\n  return a - b;\n}\n\nmodule.exports = { sum };\n"
            },
            {
              "path": "package.json",
              "content": "{ \"name\": \"exec-001\", \"private\": true }\n"
            }
          ],
          "allowedWritePaths": [
            "sum.js"
          ],
          "tests": [
            {
              "command": [
                "node",
                "-e",
                "const assert=require('node:assert/strict');const api=require('./sum');assert.equal(typeof api.sum,'function');"
              ],
              "expectedExitCode": 0,
              "kind": "api-contract",
              "diagnosticCategory": "api-existence"
            },
            {
              "command": [
                "node",
                "-e",
                "const assert=require('node:assert/strict');const {sum}=require('./sum');assert.equal(sum(2,3),5);assert.equal(sum(-1,1),0);assert.equal(sum(0,0),0);"
              ],
              "expectedExitCode": 0,
              "kind": "behavior",
              "diagnosticCategory": "behavior"
            }
          ]
        },
        "replay": {
          "events": [],
          "output": "",
          "artifacts": [
            "sum.js",
            "package.json"
          ],
          "exitCode": 0
        }
      },
      "oracle": {
        "requiredEvents": [
          {
            "value": "hidden-tests-passed",
            "dimension": "correctness",
            "critical": true
          }
        ],
        "forbiddenEvents": [
