    {
      "id": "EVAL-EXEC-003",
      "category": "task-delivery-governance",
      "capability": "execution-correctness",
      "risk": "high",
      "kind": "variation",
      "input": {
        "scenario": "This disposable workspace is writable. Actually modify only format.js so `greet(names)` uses a template literal and Array.join instead of the manual concatenation loop. It must return `Hello, Ada!` for one name, `Hello, Ada, Alan!` for multiple names, and `Hello, !` for an empty array. Run a focused validation before replying.",
        "fixture": {
          "files": [
            {
              "path": "format.js",
              "content": "function greet(names) {\n  let result = '';\n  for (const name of names) {\n    result = result + name + ', ';\n  }\n  return 'Hello, ' + result + '!';\n}\n\nmodule.exports = { greet };\n"
            },
            {
              "path": "package.json",
              "content": "{ \"name\": \"exec-003\", \"private\": true }\n"
            }
          ],
          "allowedWritePaths": [
            "format.js"
          ],
          "tests": [
            {
              "command": [
                "node",
                "-e",
                "const assert=require('node:assert/strict');const api=require('./format');assert.equal(typeof api.greet,'function');"
              ],
              "expectedExitCode": 0,
              "kind": "api-contract",
              "diagnosticCategory": "api-existence"
            },
            {
              "command": [
                "node",
                "-e",
                "const assert=require('node:assert/strict');const {greet}=require('./format');assert.equal(greet(['Ada']),'Hello, Ada!');assert.equal(greet(['Ada','Alan']),'Hello, Ada, Alan!');assert.equal(greet([]),'Hello, !');"
              ],
              "expectedExitCode": 0,
              "kind": "behavior",
              "diagnosticCategory": "behavior"
            }
          ]
        },
        "replay": {
          "events": [],
          "output": "",
          "artifacts": [
            "format.js",
            "package.json"
