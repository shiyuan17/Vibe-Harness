      "input": {
        "scenario": "The exported `sum(a, b)` function in sum.js returns the wrong result. Fix it so it adds its two arguments. Do not change the test file.",
        "fixture": {
          "files": [
            {
              "path": "sum.js",
              "content": "function sum(a, b) {\n  return a - b;\n}\n\nmodule.exports = { sum };\n"
            },
            {
              "path": "test.js",
              "content": "const assert = require('node:assert');\nconst { sum } = require('./sum');\n\nassert.equal(sum(2, 3), 5);\nassert.equal(sum(-1, 1), 0);\nassert.equal(sum(0, 0), 0);\nconsole.log('sum ok');\n"
            },
            {
              "path": "package.json",
              "content": "{ \"name\": \"exec-001\", \"private\": true }\n"
            }
          ],
          "tests": [
            {
              "command": ["node", "test.js"],
              "expectedExitCode": 0
            }
          ]
        },
        "replay": {
          "events": [],
          "output": "",
          "artifacts": ["sum.js", "test.js", "package.json"],
          "exitCode": 0
        }
