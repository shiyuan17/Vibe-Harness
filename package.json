{
  "name": "@jw/loopengine",
  "version": "0.3.0",
  "private": true,
  "description": "Reusable Codex-first AI coding governance, skills, workflow, and installer pack.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loopengine": "./scripts/loopengine.js"
  },
  "scripts": {
    "loopengine": "node ./scripts/loopengine.js",
    "lint": "node ./scripts/lint.js",
    "validate": "node ./scripts/validate.js",
    "skills:audit": "node ./scripts/skills-audit.js",
    "test": "node --test tests/*.test.js",
    "check": "node ./scripts/lint.js && node ./scripts/validate.js && node --test tests/*.test.js",
    "pack:preview": "node ./scripts/pack-preview.js",
    "smoke:lifecycle": "node ./scripts/smoke-lifecycles.js"
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || ^24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
