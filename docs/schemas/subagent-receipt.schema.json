{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cognis Subagent Receipt",
  "type": "object",
  "required": ["schemaVersion", "receiptId", "sessionIdHash", "agentIdHash", "turnIdHash", "role", "status", "startedAt", "startWorkspaceFingerprint", "startEvidenceFingerprint", "attestationScope", "continuationCount", "outputValidation", "integrityHash"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [2] },
    "receiptId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sessionIdHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "agentIdHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "turnIdHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "role": { "type": "string", "enum": ["cognis_tester", "cognis_reviewer"] },
    "status": { "type": "string", "enum": ["started", "continuation-requested", "sealed", "invalid"] },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 },
    "startWorkspaceFingerprint": { "type": "string", "pattern": "^(?:[a-f0-9]{64}|unavailable)$" },
    "completedWorkspaceFingerprint": { "type": "string", "pattern": "^(?:[a-f0-9]{64}|unavailable)$" },
    "startEvidenceFingerprint": { "type": "string", "pattern": "^(?:[a-f0-9]{64}|unavailable)$" },
    "completedEvidenceFingerprint": { "type": "string", "pattern": "^(?:[a-f0-9]{64}|unavailable)$" },
    "attestationScope": { "type": "string", "enum": ["project-local-tamper-evidence"] },
    "continuationCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "outputValidation": {
      "type": "object",
      "required": ["status", "missing", "conclusion"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "valid", "invalid"] },
        "missing": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "conclusion": { "type": "string", "enum": ["pending", "passed", "blocked", "approved", "changes-requested", "evidence-blocked", "unrecognized"] }
      },
      "additionalProperties": false
    },
    "invalidReason": { "type": "string", "minLength": 1 },
    "integrityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
