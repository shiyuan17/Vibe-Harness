{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Eval fixture manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "description", "files", "git", "faults", "hiddenChecks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^H(?:0[1-9]|1[0-9]|20)$" },
    "description": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path", "content"], "properties": { "path": { "$ref": "#/$defs/path" }, "content": { "type": "string" }, "executable": { "type": "boolean" } }, "additionalProperties": false } },
    "oracleFiles": { "type": "array", "items": { "type": "object", "required": ["path", "content"], "properties": { "path": { "$ref": "#/$defs/path" }, "content": { "type": "string" }, "executable": { "type": "boolean" } }, "additionalProperties": false } },
    "git": { "type": "object", "required": ["initialize"], "properties": { "initialize": { "type": "boolean" }, "branches": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "uniqueItems": true }, "worktrees": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "uniqueItems": true }, "branchChanges": { "type": "array", "items": { "type": "object", "required": ["branch", "files", "message"], "properties": { "branch": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }, "message": { "type": "string", "minLength": 1 } }, "additionalProperties": false } }, "conflict": { "type": ["string", "null"] } }, "additionalProperties": false },
    "faults": { "type": "array", "items": { "type": "object", "required": ["id", "trigger", "effect"], "properties": { "id": { "type": "string" }, "trigger": { "type": "string" }, "effect": { "type": "string" } }, "additionalProperties": false } },
    "hiddenChecks": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "program", "args", "expectedExitCode"], "properties": { "id": { "type": "string" }, "program": { "type": "string", "minLength": 1 }, "args": { "type": "array", "items": { "type": "string" } }, "expectedExitCode": { "type": "integer" } }, "additionalProperties": false } }
  },
  "$defs": { "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//).+$" }, "file": { "type": "object", "required": ["path", "content"], "properties": { "path": { "$ref": "#/$defs/path" }, "content": { "type": "string" }, "executable": { "type": "boolean" } }, "additionalProperties": false } },
  "additionalProperties": false
}
