{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-harness.invalid/schemas/linear-plan.schema.json",
  "title": "Vibe-Harness Linear planning contract",
  "type": "object",
  "required": ["schema", "executionMode", "wallClock", "agentPlan"],
  "properties": {
    "schema": { "type": "string", "const": "vibe-harness.linear-plan/v1" },
    "executionMode": { "type": "string", "enum": ["auto", "single", "parallel"] },
    "wallClock": {
      "type": "object",
      "required": [
        "budgetMinutes",
        "sharedPreparationMinutes",
        "externalWaitBlockMinutes",
        "activeWorkMinutes",
        "verificationMinutes",
        "singleAgentMinutes",
        "parallelAgentMinutes",
        "coordinationMinutes",
        "fanInMinutes",
        "finalIntegrationMinutes",
        "units",
        "criticalPath",
        "confidence"
      ],
      "properties": {
        "budgetMinutes": { "type": "number", "minimum": 0 },
        "sharedPreparationMinutes": { "type": "number", "minimum": 0 },
        "externalWaitBlockMinutes": { "type": "number", "minimum": 0 },
        "activeWorkMinutes": { "type": "number", "minimum": 0 },
        "verificationMinutes": { "type": "number", "minimum": 0 },
        "singleAgentMinutes": { "type": "number", "minimum": 0 },
        "parallelAgentMinutes": { "type": "number", "minimum": 0 },
        "coordinationMinutes": { "type": "number", "minimum": 0 },
        "fanInMinutes": { "type": "number", "minimum": 0 },
        "finalIntegrationMinutes": { "type": "number", "minimum": 0 },
        "uncertaintyBufferRatio": { "type": "number", "minimum": 0 },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "activeMinutes", "verificationMinutes"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "activeMinutes": { "type": "number", "minimum": 0 },
              "verificationMinutes": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "criticalPath": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "additionalProperties": false
    },
    "agentPlan": {
      "type": "object",
      "required": ["maxWriteAgents", "maxReadAgents", "fanInOwner"],
      "properties": {
        "maxWriteAgents": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maxReadAgents": { "type": "integer", "minimum": 1, "maximum": 4 },
        "fanInOwner": { "type": "string", "const": "parent-agent" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
