{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cognis 完整流程任务控制",
  "allOf": [
    {
      "type": "object",
      "required": [
        "任务类型",
        "责任角色",
        "写入范围",
        "禁止动作",
        "依赖任务",
        "并行安全",
        "停止条件",
        "回滚方案",
        "人工确认",
        "核验者",
        "合并回主线状态"
      ],
      "properties": {
        "控制版本": { "type": "integer", "enum": [2] },
        "任务类型": { "type": "string", "enum": ["单任务", "父任务", "子任务"] },
        "父任务编号": { "type": "string", "minLength": 1 },
        "子任务": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "执行批次": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "集成验证": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "责任角色": { "type": "string", "minLength": 1 },
        "写入范围": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "禁止动作": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "输入": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "输出格式": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "不得修改范围": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "依赖任务": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "冲突任务": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "并行安全": { "type": "string", "enum": ["独占写入", "共享只读", "相互独立"] },
        "时间盒分钟": { "type": "integer", "minimum": 1 },
        "停止条件": { "type": "string", "minLength": 1 },
        "回滚方案": { "type": "string", "minLength": 1 },
        "人工确认": { "type": "string", "enum": ["不需要", "需要", "已确认"] },
        "核验者": { "type": "string", "minLength": 1 },
        "红队审查者": { "type": "string", "minLength": 1 },
        "红队审查包": { "type": "string", "minLength": 1 },
        "红队审查结论": { "type": "string", "enum": ["待审查", "批准", "要求修改", "缺少证据而阻塞"] },
        "合并回主线状态": { "type": "string", "enum": ["不需要", "待处理", "已完成"] }
      },
      "additionalProperties": false
    },
    {
      "oneOf": [
        {
          "type": "object",
          "not": { "type": "object", "required": ["控制版本"] }
        },
        {
          "allOf": [
            {
              "type": "object",
              "required": ["控制版本", "冲突任务", "时间盒分钟"],
              "properties": { "控制版本": { "const": 2 } }
            },
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": { "任务类型": { "const": "单任务" } },
                  "not": {
                    "anyOf": [
                      { "type": "object", "required": ["父任务编号"] },
                      { "type": "object", "required": ["子任务"] },
                      { "type": "object", "required": ["执行批次"] },
                      { "type": "object", "required": ["集成验证"] }
                    ]
                  }
                },
                {
                  "type": "object",
                  "required": ["子任务", "执行批次", "集成验证", "冲突任务", "时间盒分钟"],
                  "properties": { "任务类型": { "const": "父任务" } },
                  "not": { "type": "object", "required": ["父任务编号"] }
                },
                {
                  "type": "object",
                  "required": ["父任务编号", "输入", "输出格式", "不得修改范围", "冲突任务", "时间盒分钟"],
                  "properties": {
                    "任务类型": { "const": "子任务" },
                    "输出格式": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
                  },
                  "not": {
                    "anyOf": [
                      { "type": "object", "required": ["子任务"] },
                      { "type": "object", "required": ["执行批次"] },
                      { "type": "object", "required": ["集成验证"] }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
