{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-harness.invalid/schemas/worktree-transaction.schema.json",
  "title": "Vibe-Harness local worktree transaction v6",
  "type": "object",
  "required": [
    "schemaVersion",
    "localOnly",
    "id",
    "target",
    "baseHead",
    "preMergeHead",
    "primaryPath",
    "expectedHead",
    "sources",
    "next",
    "phase",
    "localIntegrated"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "localOnly": {
      "const": true
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"
    },
    "target": {
      "const": "develop"
    },
    "baseHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "preMergeHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "checkpointCommit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "localMergeCommit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "next": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "phase": {
      "type": "string",
      "enum": [
        "checkpoint",
        "merging",
        "conflict",
        "local_integrated",
        "local_integrated_cleanup_pending",
        "discarded"
      ]
    },
    "localIntegrated": {
      "type": "boolean"
    },
    "integrationStatus": {
      "type": "string",
      "enum": [
        "not_integrated",
        "local_integrated",
        "local_integrated_cleanup_pending"
      ]
    },
    "conflicts": {
      "type": "array"
    },
    "cleanupPending": {
      "type": "boolean"
    },
    "cleanup": {
      "type": "array"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "branch",
          "path",
          "head",
          "harnessOwned"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "head": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "harnessOwned": {
            "type": "boolean"
          },
          "executionBatch": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "primaryPath": {
      "type": "string",
      "minLength": 1
    },
    "expectedHead": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  },
  "additionalProperties": false
}
