{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness 项目配置",
  "type": "object",
  "required": ["projectName", "language", "packageManager", "profile", "validationCommands"],
  "properties": {
    "projectName": { "type": "string", "minLength": 1 },
    "forbiddenProjectTerms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "language": { "type": "string", "enum": ["zh-CN", "en-US"] },
    "packageManager": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "enum": ["codex", "claude", "gemini", "cursor", "qoder", "zcode", "antigravity", "opencode"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["codex", "claude", "gemini", "cursor", "qoder", "zcode", "antigravity", "opencode"] }
    },
    "profile": { "type": "string", "enum": ["minimal", "core", "full", "docs-only"] },
    "preset": { "type": "string", "enum": ["everything"] },
    "modules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "plugins": {
      "type": "array",
      "items": { "type": "string", "enum": ["rtk", "ast-grep", "codebase-memory", "chrome-devtools", "playwright", "open-code-review", "codegraph", "serena", "probe"] },
      "uniqueItems": true
    },
    "validationCommands": {
      "type": "object",
      "properties": {
        "lint": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "typecheck": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "test": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "eval": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "tiers": {
          "type": "object",
          "properties": {
            "quick": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "standard": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "deep": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "layer": { "type": "string", "minLength": 1 },
              "costTier": { "type": "string", "enum": ["quick", "standard", "deep"] },
              "scopes": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["affected", "layer", "full"] }
              },
              "estimatedDurationMs": { "type": "integer", "minimum": 0 },
              "deterministic": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "micro": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["module", "rule", "pure"] },
              "entry": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])[^\\\\]*$" },
              "args": {},
              "costTier": { "type": "string", "enum": ["quick", "standard", "deep"] },
              "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["affected", "layer", "full"] } },
              "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
              "maxOutputBytes": { "type": "integer", "minimum": 256, "maximum": 1048576 },
              "outputLimit": { "type": "integer", "minimum": 256, "maximum": 1048576 },
              "deterministic": { "type": "boolean" },
              "network": { "type": "string", "enum": ["deny"] },
              "workspaceWrite": { "type": "string", "enum": ["deny"] },
              "allowedEnv": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
              "expectedExitCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer" } },
              "promotableTo": { "type": ["string", "null"], "enum": ["unit", "probe", null] },
              "environment": { "type": "string", "enum": ["cold", "warm"] }
            },
            "anyOf": [
              { "required": ["command"], "not": { "required": ["kind"] } },
              { "required": ["kind", "entry"] }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["timeoutMs"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "defaultScope": { "type": "string", "enum": ["affected", "layer", "full"] },
        "budgetMs": { "type": ["integer", "null"], "minimum": 0 },
        "environment": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["cold", "warm"] },
            "provider": { "type": "string", "minLength": 1 },
            "start": { "type": "string", "minLength": 1 },
            "health": { "type": "string", "minLength": 1 },
            "stop": { "type": "string", "minLength": 1 },
            "reuseKey": { "type": "string", "minLength": 1 },
            "ttlMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
            "fallback": { "type": "string", "enum": ["cold", "blocked"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "allowedEgressHosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "enforcement": {
          "type": "string",
          "enum": ["advisory", "strict"]
        },
        "permissionPreset": {
          "type": "string",
          "minLength": 1
        },
        "redZonePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rtk": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "riskZones": {
      "type": "object",
      "properties": {
        "red": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "yellow": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "pathPatterns": {
          "type": "object",
          "properties": {
            "red": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "yellow": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "crossRepo": {
      "type": "object",
      "required": ["enabled", "backendRepo"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backendRepo": { "type": "string" }
      },
      "additionalProperties": false
    },
    "projectRules": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "manual", "off"] },
        "overrides": {
          "type": "object",
          "properties": {
            "codingStandards": { "type": "string", "minLength": 1 },
            "directoryGuidance": { "type": "string", "minLength": 1 },
            "reviewGuidance": { "type": "string", "minLength": 1 },
            "stackSummary": { "type": "string", "minLength": 1 },
            "verificationSummary": { "type": "string", "minLength": 1 },
            "vcsSummary": { "type": "string", "minLength": 1 },
            "vcsStatusCommand": { "type": "string", "minLength": 1 },
            "packageManager": { "type": "string", "minLength": 1 },
            "logging": {
              "type": "object",
              "properties": {
                "frameworks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "configFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "queries": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "correlationFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "verification": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "clarification": {
      "type": "object",
      "required": ["posture"],
      "properties": {
        "posture": { "type": "string", "enum": ["action-leaning", "balanced", "conservative"] }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": ["enabled", "path"],
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "worktree": {
      "type": "object",
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "baseRef": { "type": "string", "minLength": 1 },
        "dependencyRoots": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "localPackages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "ports": {
          "type": "object",
          "properties": {
            "base": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "blockSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "variables": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(?:[A-Z][A-Z0-9]*_)*PORT(?:_[A-Z0-9]+)*$" }
            },
            "envFile": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\][^\\\\]*$" }
          },
          "additionalProperties": false
        },
        "provision": {
          "type": "object",
          "properties": {
            "setupCommands": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "envFiles": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "disabled": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "promptPath": { "type": "string", "pattern": "^docs/agent-roles/[a-zA-Z0-9][a-zA-Z0-9._-]*\\.md$" },
              "permissionPreset": { "type": "string", "enum": ["analysis", "implementation", "verification", "security-review", "release-readiness"] }
            },
            "additionalProperties": false
          }
        },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "description", "promptPath", "permissionPreset", "routing"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
              "name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "description": { "type": "string", "minLength": 1, "maxLength": 256 },
              "promptPath": { "type": "string", "pattern": "^docs/agent-roles/[a-zA-Z0-9][a-zA-Z0-9._-]*\\.md$" },
              "permissionPreset": { "type": "string", "enum": ["analysis", "implementation", "verification", "security-review", "release-readiness"] },
              "routing": {
                "type": "object",
                "required": ["when", "avoid"],
                "properties": {
                  "when": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
                  "avoid": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
                  "mode": { "type": "string", "enum": ["auto", "explicit"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evaluations": {
      "type": "object",
      "required": ["enabled", "suites", "reference", "thresholds", "onlineRunner", "repetitions"],
      "properties": {
        "enabled": { "type": "boolean" },
        "suites": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reference": { "type": "string", "minLength": 1 },
        "thresholds": {
          "type": "object",
          "required": ["criticalPassRate", "overallScore", "maxCapabilityRegression"],
          "properties": {
            "criticalPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "overallScore": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxCapabilityRegression": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "onlineRunner": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "additionalProperties": false
    },
    "installedSurface": {
      "type": "object",
      "properties": {
        "skillsLine": { "type": "string" },
        "hooksLine": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
