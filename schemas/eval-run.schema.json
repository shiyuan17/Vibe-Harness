{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoopEngine evaluation run",
  "type": "object",
  "required": ["schemaVersion", "id", "generatedAt", "suite", "mode", "status", "fingerprint", "caseRepetitions", "cases", "capabilities", "overallScore", "criticalPassRate", "diagnostics"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "suite": { "type": "object", "required": ["id", "version", "hash", "path"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "hash": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "mode": { "type": "string", "enum": ["offline", "online"] },
    "status": { "type": "string", "enum": ["passed", "failed", "degraded"] },
    "fingerprint": { "type": "object", "required": ["suiteHash", "runner", "model", "agent", "governanceHash"], "properties": { "suiteHash": { "type": "string", "minLength": 1 }, "runner": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "agent": { "type": "string", "minLength": 1 }, "governanceHash": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "reference": { "type": "object", "required": ["path", "status"], "properties": { "path": { "type": "string", "minLength": 1 }, "status": { "type": "string", "enum": ["matched", "mismatched", "missing"] } }, "additionalProperties": false },
    "caseRepetitions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "count"], "properties": { "id": { "type": "string", "minLength": 1 }, "count": { "type": "integer", "minimum": 1, "maximum": 3 } }, "additionalProperties": false } },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "capability", "passed", "score", "weight", "criticalAssertions", "criticalFailures", "dimensionScores", "assertions"], "properties": { "id": { "type": "string", "minLength": 1 }, "capability": { "type": "string", "minLength": 1 }, "passed": { "type": "boolean" }, "score": { "type": "number", "minimum": 0, "maximum": 1 }, "weight": { "type": "number", "exclusiveMinimum": 0 }, "criticalAssertions": { "type": "integer", "minimum": 0 }, "criticalFailures": { "type": "integer", "minimum": 0 }, "dimensionScores": { "type": "object", "required": ["correctness", "safety", "evidenceQuality", "efficiency"], "properties": { "correctness": { "type": "number", "minimum": 0, "maximum": 1 }, "safety": { "type": "number", "minimum": 0, "maximum": 1 }, "evidenceQuality": { "type": "number", "minimum": 0, "maximum": 1 }, "efficiency": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false }, "assertions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["kind", "dimension", "critical", "expected", "passed"], "properties": { "kind": { "type": "string", "enum": ["required-event", "forbidden-event", "required-output-fragment", "forbidden-output-fragment", "required-artifact", "forbidden-artifact", "exit-code"] }, "dimension": { "type": "string", "enum": ["correctness", "safety", "evidenceQuality", "efficiency"] }, "critical": { "type": "boolean" }, "expected": {}, "passed": { "type": "boolean" } }, "additionalProperties": false } } }, "additionalProperties": false } },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "caseCount", "passedCount", "score"], "properties": { "id": { "type": "string", "minLength": 1 }, "caseCount": { "type": "integer", "minimum": 1 }, "passedCount": { "type": "integer", "minimum": 0 }, "score": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false } },
    "overallScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "criticalPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
