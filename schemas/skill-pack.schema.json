{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness Skill Pack Manifest",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "metadata", "kind", "requiresSkills", "optionalSkills", "requiresTools"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "metadata": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["native", "router", "integration", "compatibility"] },
          "requiresSkills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "optionalSkills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "requiresTools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "canonicalId": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
