{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cognis Handoff Record",
  "type": "object",
  "required": ["版本", "编号", "类型", "来源角色", "目标角色", "Agent/运行收据", "状态", "变更集指纹", "已完成", "未完成", "验证证据", "未验证项", "风险", "下一步", "恢复提示", "时间"],
  "properties": {
    "版本": { "type": "integer", "enum": [1] },
    "编号": { "type": "string", "minLength": 1 },
    "类型": { "type": "string", "enum": ["阶段交接", "子任务回传", "暂停恢复"] },
    "来源角色": { "type": "string", "minLength": 1 },
    "目标角色": { "type": "string", "minLength": 1 },
    "Agent/运行收据": { "type": "string", "minLength": 1 },
    "状态": { "type": "string", "enum": ["待接收", "已接收", "已返回", "阻塞"] },
    "变更集指纹": { "type": "string", "pattern": "^(?:[a-f0-9]{64}|不适用)$" },
    "已完成": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "未完成": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "验证证据": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "未验证项": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "风险": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "下一步": { "type": "string", "minLength": 1 },
    "恢复提示": { "type": "string", "minLength": 1 },
    "时间": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
