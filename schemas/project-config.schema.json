{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness 项目配置",
  "type": "object",
  "required": ["projectName", "language", "packageManager", "profile", "validationCommands"],
  "properties": {
    "projectName": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "enum": ["zh-CN", "en-US"] },
    "packageManager": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "enum": ["codex", "claude", "gemini", "cursor", "qoder", "zcode", "antigravity", "opencode"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["codex", "claude", "gemini", "cursor", "qoder", "zcode", "antigravity", "opencode"] }
    },
    "profile": { "type": "string", "enum": ["minimal", "core", "full", "docs-only"] },
    "modules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "plugins": {
      "type": "array",
      "items": { "type": "string", "enum": ["rtk", "ast-grep", "codebase-memory", "chrome-devtools", "playwright", "open-code-review"] },
      "uniqueItems": true
    },
    "validationCommands": {
      "type": "object",
      "properties": {
        "lint": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "typecheck": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "test": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "eval": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["timeoutMs"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "const": "guarded" },
        "allowedWriteRoots": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedEgressHosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "redZonePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rtk": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "riskZones": {
      "type": "object",
      "properties": {
        "red": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "yellow": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "crossRepo": {
      "type": "object",
      "required": ["enabled", "backendRepo"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backendRepo": { "type": "string" }
      },
      "additionalProperties": false
    },
    "projectRules": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "manual", "off"] },
        "overrides": {
          "type": "object",
          "properties": {
            "codingStandards": { "type": "string", "minLength": 1 },
            "directoryGuidance": { "type": "string", "minLength": 1 },
            "reviewGuidance": { "type": "string", "minLength": 1 },
            "stackSummary": { "type": "string", "minLength": 1 },
            "verificationSummary": { "type": "string", "minLength": 1 },
            "vcsSummary": { "type": "string", "minLength": 1 },
            "vcsStatusCommand": { "type": "string", "minLength": 1 },
            "packageManager": { "type": "string", "minLength": 1 },
            "logging": {
              "type": "object",
              "properties": {
                "frameworks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "configFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "queries": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "correlationFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "verification": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "clarification": {
      "type": "object",
      "required": ["posture"],
      "properties": {
        "posture": { "type": "string", "enum": ["action-leaning", "balanced", "conservative"] }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": ["enabled", "path"],
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "disabled": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "promptPath": { "type": "string", "pattern": "^docs/agent-roles/[a-zA-Z0-9][a-zA-Z0-9._-]*\\.md$" },
              "permissionPreset": { "type": "string", "enum": ["analysis", "implementation", "verification", "security-review", "release-readiness"] }
            },
            "additionalProperties": false
          }
        },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "description", "promptPath", "permissionPreset", "routing"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
              "name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "description": { "type": "string", "minLength": 1, "maxLength": 256 },
              "promptPath": { "type": "string", "pattern": "^docs/agent-roles/[a-zA-Z0-9][a-zA-Z0-9._-]*\\.md$" },
              "permissionPreset": { "type": "string", "enum": ["analysis", "implementation", "verification", "security-review", "release-readiness"] },
              "routing": {
                "type": "object",
                "required": ["when", "avoid"],
                "properties": {
                  "when": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
                  "avoid": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evaluations": {
      "type": "object",
      "required": ["enabled", "suites", "reference", "thresholds", "onlineRunner", "repetitions"],
      "properties": {
        "enabled": { "type": "boolean" },
        "suites": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reference": { "type": "string", "minLength": 1 },
        "thresholds": {
          "type": "object",
          "required": ["criticalPassRate", "overallScore", "maxCapabilityRegression"],
          "properties": {
            "criticalPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "overallScore": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxCapabilityRegression": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "onlineRunner": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "additionalProperties": false
    },
    "installedSurface": {
      "type": "object",
      "properties": {
        "skillsLine": { "type": "string" },
        "hooksLine": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
