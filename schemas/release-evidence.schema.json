{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness release evidence",
  "type": "object",
  "required": ["schemaVersion", "releaseTag", "version", "releaseSha", "verification", "checks", "tarball", "attestationStatus", "rollbackStrategy"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "releaseTag": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "releaseSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "verification": {
      "type": "object",
      "required": ["id", "finishedAt", "stable", "sha"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "finishedAt": { "type": "string", "minLength": 1 },
        "stable": { "type": "boolean" },
        "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "const": "passed" }
        },
        "additionalProperties": false
      }
    },
    "tarball": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[^/\\\\]+\\.tgz$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "attestationStatus": { "type": "string", "enum": ["generated", "unavailable", "failed"] },
    "rollbackStrategy": { "type": "string", "const": "revert-and-new-patch-release" }
  },
  "additionalProperties": false
}
