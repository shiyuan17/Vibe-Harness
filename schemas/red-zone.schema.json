{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness 红区清单",
  "type": "object",
  "required": ["schemaVersion", "runtimePaths", "installPatterns"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runtimePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "installPatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
