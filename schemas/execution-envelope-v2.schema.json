{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-harness.invalid/schemas/execution-envelope-v2.schema.json",
  "title": "Vibe-Harness Execution Envelope v2",
  "type": "object",
  "required": ["schema", "requestId", "sessionId", "mode", "targetIssueIds", "allowedEffects", "forbiddenEffects", "terminalCondition", "activeObjective", "riskClass", "scope", "hostContext"],
  "properties": {
    "schema": { "type": "string", "const": "vibe-harness.execution-envelope/v2" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "mode": { "type": "string", "enum": ["inspect", "plan", "linear-sync", "execute", "monitor"] },
    "targetIssueIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "allowedEffects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["linearWrite", "workspaceWrite", "hostWrite", "externalWrite", "gitBranch", "gitCommit", "gitPush", "mergeRequestWrite", "credentialUse"] }
    },
    "forbiddenEffects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["linearWrite", "workspaceWrite", "hostWrite", "externalWrite", "gitBranch", "gitCommit", "gitPush", "mergeRequestWrite", "credentialUse"] }
    },
    "terminalCondition": { "type": "string", "minLength": 1, "maxLength": 512 },
    "activeObjective": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "riskClass": { "type": "string", "enum": ["standard", "high"] },
    "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" },
    "scope": {
      "type": "object",
      "required": ["workspace", "externalTargets"],
      "properties": {
        "workspace": {
          "type": "object",
          "required": ["canonicalCwd", "worktreeRoot", "gitCommonDir", "gitDir", "branch", "baseRef", "baseSha", "initialHeadSha", "allowedWriteRoots"],
          "properties": {
            "canonicalCwd": { "type": "string", "minLength": 1 },
            "worktreeRoot": { "type": "string", "minLength": 1 },
            "gitCommonDir": { "type": "string", "minLength": 1 },
            "gitDir": { "type": "string", "minLength": 1 },
            "branch": { "type": "string", "minLength": 1 },
            "baseRef": { "type": "string", "minLength": 1 },
            "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
            "initialHeadSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
            "allowedWriteRoots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "externalTargets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["kind", "id", "environment"],
            "properties": {
              "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
              "id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "environment": { "type": "string", "enum": ["local", "test", "staging", "production", "remote"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hostContext": {
      "type": "object",
      "required": ["source", "filesystem", "approval", "process", "network", "observedAt"],
      "properties": {
        "source": { "type": "string", "const": "host" },
        "filesystem": { "type": "string", "enum": ["read-only", "workspace-write", "unrestricted"] },
        "approval": { "type": "string", "enum": ["interactive", "unavailable"] },
        "process": { "type": "string", "enum": ["isolated", "unrestricted"] },
        "network": { "type": "string", "enum": ["offline", "allowlisted", "unrestricted"] },
        "observedAt": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" }
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["activeObjective", "targetIssueId", "completedFacts", "noRepeatSet", "nextAction", "liveStates", "blockerFingerprint", "dagStructureHash", "headSha", "continuationCount", "blockerCount"],
      "properties": {
        "activeObjective": { "type": "string", "minLength": 1 },
        "targetIssueId": { "type": "string", "minLength": 1 },
        "completedFacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "noRepeatSet": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "nextAction": { "type": "string", "minLength": 1 },
        "liveStates": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "blockerFingerprint": { "type": "string" },
        "dagStructureHash": { "type": "string" },
        "dagChangeCursor": { "type": "string" },
        "observedAt": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" },
        "headSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "continuationCount": { "type": "integer", "minimum": 0 },
        "blockerCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
