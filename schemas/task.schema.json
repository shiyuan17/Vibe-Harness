{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoopEngine Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "phase",
    "status",
    "resolution",
    "goal",
    "acceptanceCriteria",
    "nonGoals",
    "writeScope",
    "forbiddenActions",
    "verification",
    "stopCondition",
    "rollbackPlan"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "parent": { "type": "string", "minLength": 1 },
    "taskKind": {
      "type": "string",
      "enum": ["single", "parent", "child"]
    },
    "title": { "type": "string", "minLength": 1 },
    "ownerRole": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "phase": {
      "type": "string",
      "enum": ["clarify", "spec", "plan", "decompose", "ready", "execute", "verify", "review", "handoff", "done"]
    },
    "status": {
      "type": "string",
      "enum": ["idle", "running", "in_progress", "blocked", "waiting_human", "waiting_dependency", "failed_validation"]
    },
    "resolution": {
      "type": "string",
      "enum": ["open", "done", "wont_do", "duplicate", "cancelled"]
    },
    "goal": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "splitRationale": { "type": "string", "minLength": 1 },
    "nonGoals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "writeScope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbiddenActions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "parallelSafety": {
      "type": "string",
      "enum": ["exclusive", "shared-readonly", "independent"]
    },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "conflictsWith": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "humanConfirmation": {
      "type": "string",
      "enum": ["not_required", "required", "confirmed"]
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "integrationVerification": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stopCondition": { "type": "string", "minLength": 1 },
    "rollbackPlan": { "type": "string", "minLength": 1 },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "goal",
          "acceptanceCriteria",
          "writeScope",
          "verification",
          "stopCondition",
          "parallelSafety",
          "dependsOn",
          "humanConfirmation"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "ownerRole": { "type": "string", "minLength": 1 },
          "phase": { "type": "string", "enum": ["clarify", "spec", "plan", "decompose", "ready", "execute", "verify", "review", "handoff", "done"] },
          "status": { "type": "string", "enum": ["idle", "running", "in_progress", "blocked", "waiting_human", "waiting_dependency", "failed_validation"] },
          "resolution": { "type": "string", "enum": ["open", "done", "wont_do", "duplicate", "cancelled"] },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "goal": { "type": "string", "minLength": 1 },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "writeScope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "stopCondition": { "type": "string", "minLength": 1 },
          "parallelSafety": {
            "type": "string",
            "enum": ["exclusive", "shared-readonly", "independent"]
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "humanConfirmation": {
            "type": "string",
            "enum": ["not_required", "required", "confirmed"]
          },
          "forbiddenActions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "rollbackPlan": { "type": "string", "minLength": 1 },
          "splitRationale": { "type": "string", "minLength": 1 }
          ,"verifier": { "type": "string", "minLength": 1 }
          ,"mergeBackStatus": { "type": "string", "enum": ["not_required", "pending", "complete"] }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nextAction": { "type": "string", "minLength": 1 }
    ,"resumeHint": { "type": "string", "minLength": 1 }
    ,"blockedReason": { "type": "string", "minLength": 1 }
    ,"packetTier": { "type": "string", "enum": ["Fast Path", "Lightweight", "Full"] }
    ,"implementTier": { "type": "string", "enum": ["Fast Path", "Lightweight", "Full"] }
    ,"verifier": { "type": "string", "minLength": 1 }
    ,"mergeBackStatus": { "type": "string", "enum": ["not_required", "pending", "complete"] }
    ,"crossRepoEvidence": {
      "type": "object",
      "properties": {
        "backendRef": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "minLength": 1 },
        "verifyCommand": { "type": "string", "minLength": 1 },
        "resultSummary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
