{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cognis evaluation suite",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "description", "defaultRepetitions", "cases"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "defaultRepetitions": { "type": "integer", "minimum": 1, "maximum": 3 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "capability", "risk", "input", "oracle", "weights", "repetitions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["install-lifecycle", "task-delivery-governance", "skill-routing", "safety-isolation"] },
          "capability": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "input": {
            "type": "object",
            "required": ["scenario", "replay"],
            "properties": {
              "scenario": { "type": "string", "minLength": 1 },
              "fixture": {
                "type": "object",
                "required": ["files"],
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["path", "content"],
                      "properties": {
                        "path": { "type": "string", "minLength": 1 },
                        "content": { "type": "string" }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "replay": {
                "type": "object",
                "required": ["events", "output", "artifacts", "exitCode"],
                "properties": {
                  "events": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                  "output": { "type": "string" },
                  "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                  "exitCode": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "oracle": {
            "type": "object",
            "required": ["requiredEvents", "forbiddenEvents", "requiredOutputFragments", "forbiddenOutputFragments", "requiredArtifacts", "forbiddenArtifacts", "exitCode"],
            "properties": {
              "requiredEvents": { "type": "array", "items": { "type": "object", "required": ["value", "dimension", "critical"], "properties": { "value": { "type": "string", "minLength": 1 }, "dimension": { "type": "string", "enum": ["correctness", "safety", "evidenceQuality", "efficiency"] }, "critical": { "type": "boolean" } }, "additionalProperties": false } },
              "forbiddenEvents": { "type": "array", "items": { "type": "object", "required": ["value", "dimension", "critical"], "properties": { "value": { "type": "string", "minLength": 1 }, "dimension": { "type": "string", "enum": ["correctness", "safety", "evidenceQuality", "efficiency"] }, "critical": { "type": "boolean" } }, "additionalProperties": false } },
              "requiredOutputFragments": { "type": "array", "items": { "type": "object", "required": ["value", "dimension", "critical"], "properties": { "value": { "type": "string", "minLength": 1 }, "dimension": { "type": "string", "enum": ["correctness", "safety", "evidenceQuality", "efficiency"] }, "critical": { "type": "boolean" } }, "additionalProperties": false } },
              "forbiddenOutputFragments": { "type": "array", "items": { "type": "object", "required": ["value", "dimension", "critical"], "properties": { "value": { "type": "string", "minLength": 1 }, "dimension": { "type": "string", "enum": ["correctness", "safety", "evidenceQuality", "efficiency"] }, "critical": { "type": "boolean" } }, "additionalProperties": false } },
              "requiredArtifacts": { "type": "array", "items": { "type": "object", "required": ["value", "dimension", "critical"], "properties": { "value": { "type": "string", "minLength": 1 }, "dimension": { "type": "string", "enum": ["correctness", "safety", "evidenceQuality", "efficiency"] }, "critical": { "type": "boolean" } }, "additionalProperties": false } },
              "forbiddenArtifacts": { "type": "array", "items": { "type": "object", "required": ["value", "dimension", "critical"], "properties": { "value": { "type": "string", "minLength": 1 }, "dimension": { "type": "string", "enum": ["correctness", "safety", "evidenceQuality", "efficiency"] }, "critical": { "type": "boolean" } }, "additionalProperties": false } },
              "exitCode": { "type": "object", "required": ["value", "dimension", "critical"], "properties": { "value": { "type": "integer", "minimum": 0 }, "dimension": { "type": "string", "enum": ["correctness", "safety", "evidenceQuality", "efficiency"] }, "critical": { "type": "boolean" } }, "additionalProperties": false }
            },
            "additionalProperties": false
          },
          "weights": {
            "type": "object",
            "required": ["correctness", "safety", "evidenceQuality", "efficiency"],
            "properties": {
              "correctness": { "type": "number", "minimum": 0, "maximum": 10 },
              "safety": { "type": "number", "minimum": 0, "maximum": 10 },
              "evidenceQuality": { "type": "number", "minimum": 0, "maximum": 10 },
              "efficiency": { "type": "number", "minimum": 0, "maximum": 10 }
            },
            "additionalProperties": false
          },
          "repetitions": { "type": "integer", "minimum": 1, "maximum": 3 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
