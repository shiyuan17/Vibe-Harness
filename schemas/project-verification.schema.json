{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness 项目验证回执",
  "type": "object",
  "required": ["scope", "status", "verification"],
  "properties": {
    "scope": { "const": "project" },
    "status": { "enum": ["ready", "invalid"] },
    "verification": {
      "type": "object",
      "required": ["schemaVersion", "engine", "id", "startedAt", "finishedAt", "riskLevel", "planMode", "selectedChecks", "skippedChecks", "fallbackUsed", "selectionReasons"],
      "properties": {
        "schemaVersion": { "type": "integer", "enum": [2, 3] },
        "engine": { "const": "vibe-harness-cli" },
        "id": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "minLength": 1 },
        "finishedAt": { "type": "string", "minLength": 1 },
        "riskLevel": { "enum": ["quick", "standard", "high"] },
        "planMode": { "enum": ["auto", "full"] },
        "scope": { "enum": ["affected", "layer", "full"] },
        "scopeConfidence": { "enum": ["complete", "lower-bound", "unknown"] },
        "budgetMs": { "type": ["integer", "null"], "minimum": 0 },
        "estimatedCostMs": { "type": ["integer", "null"], "minimum": 0 },
        "environment": { "type": "object" },
        "cache": { "type": "object" },
        "snapshotComparison": { "enum": ["match", "changed", "unknown"] },
        "impactGroups": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "selectedChecks": { "type": "array", "items": { "type": "object" } },
        "deferredChecks": { "type": "array", "items": { "type": "object" } },
        "deferredMicroChecks": { "type": "array", "items": { "type": "object" } },
        "selectedMicroChecks": { "type": "array", "items": { "type": "object" } },
        "minimumTier": { "type": ["string", "null"] },
        "nextTier": { "type": ["string", "null"] },
        "escalation": { "type": "object" },
        "skippedChecks": { "type": "array", "items": { "type": "object" } },
        "fallbackUsed": { "type": "boolean" },
        "selectionReasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
