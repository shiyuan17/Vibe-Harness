{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cognis Adapter Install Map",
  "type": "object",
  "required": ["adapter", "entries"],
  "properties": {
    "adapter": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group", "source", "target", "contentStrategy"],
        "properties": {
          "group": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "contentStrategy": { "type": "string", "enum": ["managed-instruction-block", "managed-toml-block", "replace"] },
          "executable": { "type": "boolean" },
          "redZone": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "retiredEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group", "target"],
        "properties": {
          "group": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "redZone": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
