{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness 项目基线",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "project", "installation", "verification", "recommendations", "drift"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [2] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "project": {
      "type": "object",
      "required": ["name", "packageManager", "stackSummary", "directoryGuidance", "logging", "vcs"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "packageManager": { "type": "string", "minLength": 1 },
        "stackSummary": { "type": "string", "minLength": 1 },
        "directoryGuidance": { "type": "string", "minLength": 1 },
        "logging": {
          "type": "object",
          "required": ["status", "evidence", "contract"],
          "properties": {
            "status": { "type": "string", "enum": ["complete", "partial", "unknown"] },
            "evidence": {
              "type": "object",
              "required": ["frameworks", "configFiles", "queryCandidates", "correlationCandidates"],
              "properties": {
                "frameworks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "configFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "queryCandidates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "correlationCandidates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              },
              "additionalProperties": false
            },
            "contract": {
              "type": "object",
              "required": ["frameworks", "configFiles", "sources", "queries", "correlationFields", "verification"],
              "properties": {
                "frameworks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "configFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "queries": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "correlationFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "verification": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "vcs": {
          "type": "object",
          "required": ["kind", "workingTreeStatus"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "workingTreeStatus": { "type": "string", "enum": ["clean", "dirty", "unknown"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "installation": {
      "type": "object",
      "required": ["managedFileCount", "profile", "requestedPlugins", "resolvedModules", "status", "tools", "version"],
      "properties": {
        "managedFileCount": { "type": "integer", "minimum": 0 },
        "profile": { "type": "string", "enum": ["minimal", "core", "full", "docs-only"] },
        "requestedPlugins": {
          "type": "array",
          "items": { "type": "string", "enum": ["rtk", "ast-grep", "codebase-memory", "chrome-devtools", "playwright", "open-code-review"] },
          "uniqueItems": true
        },
        "resolvedModules": {
          "type": "array",
          "items": { "type": "string", "enum": ["agents", "rules", "templates", "skills", "schemas", "evals", "memory", "playwright", "chrome-devtools", "codebase-memory", "open-code-review", "rtk", "ast-grep", "hooks", "roles"] },
          "uniqueItems": true
        },
        "status": { "type": "string", "enum": ["consistent"] },
        "tools": {
          "type": "object",
          "properties": {
            "playwrightCli": {
              "type": "object",
              "required": ["phase", "status", "version"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "enum": ["degraded", "pending", "pending-config", "ready"] },
                "version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "codebaseMemoryMcp": {
              "type": "object",
              "required": ["phase", "status", "version"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "enum": ["degraded", "pending", "pending-config", "ready"] },
                "version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "chromeDevtoolsMcp": {
              "type": "object",
              "required": ["phase", "status", "version"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "enum": ["degraded", "pending", "pending-config", "ready"] },
                "version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "openCodeReview": {
              "type": "object",
              "required": ["phase", "status", "version"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "enum": ["degraded", "pending", "pending-config", "ready"] },
                "version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "rtk": {
              "type": "object",
              "required": ["phase", "platform", "source", "status", "version"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "minLength": 1 },
                "platform": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "enum": ["degraded", "pending", "ready", "unsupported"] },
                "version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "astGrep": {
              "type": "object",
              "required": ["phase", "platform", "source", "status", "version"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "minLength": 1 },
                "platform": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "enum": ["degraded", "pending", "ready", "unsupported"] },
                "version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["mode", "status", "commands"],
      "properties": {
        "mode": { "type": "string", "enum": ["static", "executed"] },
        "status": { "type": "string", "enum": ["not_run", "passed", "failed", "blocked"] },
        "commands": {
          "type": "object",
          "required": ["lint", "typecheck", "test", "eval"],
          "properties": {
            "test": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "exitCode": { "type": "integer", "minimum": 0 },
                "status": { "type": "string", "enum": ["available", "blocked", "failed", "manual", "missing", "not_configured", "passed"] }
              },
              "additionalProperties": false
            },
            "lint": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "exitCode": { "type": "integer", "minimum": 0 },
                "status": { "type": "string", "enum": ["available", "blocked", "failed", "manual", "missing", "not_configured", "passed"] }
              },
              "additionalProperties": false
            },
            "typecheck": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "exitCode": { "type": "integer", "minimum": 0 },
                "status": { "type": "string", "enum": ["available", "blocked", "failed", "manual", "missing", "not_configured", "passed"] }
              },
              "additionalProperties": false
            },
            "eval": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "exitCode": { "type": "integer", "minimum": 0 },
                "status": { "type": "string", "enum": ["available", "blocked", "failed", "manual", "missing", "not_configured", "passed"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "priority"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] }
        },
        "additionalProperties": false
      }
    },
    "drift": {
      "type": "object",
      "required": ["changes", "status"],
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "before": {},
              "after": {}
            },
            "additionalProperties": false
          }
        },
        "status": { "type": "string", "enum": ["initial", "unchanged", "changed"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
