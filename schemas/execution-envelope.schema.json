{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-harness.invalid/schemas/execution-envelope.schema.json",
  "title": "Vibe-Harness Execution Envelope",
  "type": "object",
  "required": ["schema", "requestId", "sessionId", "mode", "targetIssueIds", "allowedEffects", "forbiddenEffects", "terminalCondition", "activeObjective"],
  "properties": {
    "schema": { "type": "string", "const": "vibe-harness.execution-envelope/v1" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "mode": { "type": "string", "enum": ["inspect", "plan", "linear-sync", "execute", "monitor"] },
    "targetIssueIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "allowedEffects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["linearWrite", "workspaceWrite", "gitBranch", "gitCommit", "gitPush", "mergeRequestWrite", "credentialUse"] }
    },
    "forbiddenEffects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["linearWrite", "workspaceWrite", "gitBranch", "gitCommit", "gitPush", "mergeRequestWrite", "credentialUse"] }
    },
    "terminalCondition": { "type": "string", "minLength": 1, "maxLength": 512 },
    "activeObjective": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" },
    "checkpoint": {
      "type": "object",
      "required": ["activeObjective", "targetIssueId", "completedFacts", "noRepeatSet", "nextAction", "liveStates", "blockerFingerprint", "dagStructureHash"],
      "properties": {
        "activeObjective": { "type": "string", "minLength": 1 },
        "targetIssueId": { "type": "string", "minLength": 1 },
        "completedFacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "noRepeatSet": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "nextAction": { "type": "string", "minLength": 1 },
        "liveStates": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "blockerFingerprint": { "type": "string" },
        "dagStructureHash": { "type": "string" },
        "dagChangeCursor": { "type": "string" },
        "observedAt": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
