{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-harness.invalid/schemas/worktree-transaction.schema.json",
  "title": "Vibe-Harness worktree delivery transaction v5",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "target",
    "baseHead",
    "sources",
    "candidate",
    "next",
    "phase",
    "queue"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        4,
        5
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "baseHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "candidateHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "stagedRef": {
      "type": "string",
      "pattern": "^refs/vibe-harness/staged/"
    },
    "remoteConfirmedHead": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "remoteAdvanced": {
      "type": "boolean"
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "next": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "phase": {
      "type": "string",
      "enum": [
        "merging",
        "conflict",
        "merged",
        "queued",
        "staged",
        "publishing",
        "push_uncertain",
        "push_confirmed",
        "cleanup_pending",
        "recovery_required",
        "archived_integrated",
        "cleaned"
      ]
    },
    "reconcileHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "kind",
          "fromPhase",
          "remoteHead",
          "fromCandidateHead",
          "toCandidateHead"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string",
            "enum": [
              "integrated",
              "archived-integrated",
              "rebuilt"
            ]
          },
          "fromPhase": {
            "type": "string",
            "enum": [
              "merging",
              "conflict",
              "merged",
              "queued",
              "staged",
              "publishing",
              "push_uncertain",
              "push_confirmed",
              "cleanup_pending",
              "recovery_required",
              "archived_integrated",
              "cleaned"
            ]
          },
          "remoteHead": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "fromCandidateHead": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "toCandidateHead": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40,64}$"
          }
        }
      }
    },
    "verifyFailure": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "failureType",
        "candidateFailed",
        "at",
        "status",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "LAND_VERIFY_FAILED",
            "LAND_VERIFY_ENVIRONMENT_FAILED"
          ]
        },
        "failureType": {
          "type": "string",
          "enum": [
            "checks-failed",
            "snapshot-drift",
            "snapshot-unknown",
            "blocked",
            "stale",
            "not-run"
          ]
        },
        "candidateFailed": {
          "type": "boolean"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "archive": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "at",
            "reason",
            "remoteHead",
            "integratedSourceHeads"
          ],
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "reason": {
              "type": "string"
            },
            "remoteHead": {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            "integratedSourceHeads": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "archivedAt",
            "status",
            "remoteHead",
            "integratedSourceHeads"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "archivedAt": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "const": "completed"
            },
            "remoteHead": {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            "integratedSourceHeads": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "branch",
                  "head"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "branch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "head": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40,64}$"
                  }
                }
              }
            },
            "candidateCleanup": {
              "type": "array"
            },
            "stagedRefCleanup": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "deleted"
              ],
              "properties": {
                "deleted": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                }
              }
            },
            "preserved": {
              "type": "array"
            }
          }
        }
      ]
    },
    "queue": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ticketId",
        "state"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ticketId": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "cancelled",
            "expired"
          ]
        },
        "position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ahead": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "waitedMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commandStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked",
        "unavailable",
        "planned"
      ]
    },
    "integrationStatus": {
      "type": "string",
      "enum": [
        "not_integrated",
        "local_staged",
        "integrated",
        "integrated_cleanup_pending"
      ]
    },
    "remoteValidation": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "passed",
        "failed",
        "stale",
        "unavailable"
      ]
    },
    "localRefSync": {
      "type": "string",
      "enum": [
        "not_attempted",
        "updated",
        "deferred",
        "diverged"
      ]
    },
    "pushTarget": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "remote",
        "ref"
      ],
      "properties": {
        "remote": {
          "const": "origin"
        },
        "ref": {
          "const": "refs/heads/develop"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unavailable": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "branch",
          "path",
          "head"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "id",
        "path",
        "ports"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "ports": {
          "type": "object"
        }
      }
    },
    "pushProof": {
      "type": [
        "string",
        "null"
      ]
    },
    "cleanedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceCleanup": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
