{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-harness.invalid/schemas/worktree-transaction.schema.json",
  "title": "Vibe-Harness worktree delivery transaction v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "target",
    "baseHead",
    "sources",
    "candidate",
    "next",
    "phase"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "baseHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "candidateHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "stagedRef": {
      "type": "string",
      "pattern": "^refs/vibe-harness/staged/"
    },
    "remoteConfirmedHead": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "remoteAdvanced": {
      "type": "boolean"
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "next": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "phase": {
      "type": "string",
      "enum": [
        "merging",
        "conflict",
        "merged",
        "staged",
        "verified",
        "local_merged",
        "push_uncertain",
        "push_confirmed",
        "cleanup_pending"
      ]
    },
    "commandStatus": {
      "type": "string",
      "enum": ["passed", "failed", "blocked", "unavailable", "planned"]
    },
    "integrationStatus": {
      "type": "string",
      "enum": [
        "not_integrated",
        "local_staged",
        "local_merged",
        "integrated",
        "integrated_cleanup_pending"
      ]
    },
    "remoteValidation": {
      "type": "string",
      "enum": ["not_required", "pending", "passed", "failed", "stale", "unavailable"]
    },
    "localRefSync": {
      "type": "string",
      "enum": ["not_attempted", "updated", "deferred", "diverged"]
    },
    "pushTarget": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["remote", "ref"],
      "properties": {
        "remote": {
          "const": "origin"
        },
        "ref": {
          "const": "refs/heads/develop"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unavailable": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "branch", "path", "head"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
