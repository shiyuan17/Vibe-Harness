{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cognis capability catalog",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [2] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "disposition", "tests", "profiles", "docs", "evaluation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["generalize", "validator", "template", "project-only", "excluded-with-reason"] },
          "targets": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "docs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "reason": { "type": "string", "minLength": 1 },
          "evaluation": {
            "type": "object",
            "required": ["required"],
            "properties": {
              "required": { "type": "boolean" },
              "suites": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
