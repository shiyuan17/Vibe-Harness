{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness 安装预设目录",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "profile", "plugins", "allowPreview", "provision"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "addModules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "plugins": {
            "type": "object",
            "required": ["all"],
            "properties": {
              "all": { "type": "boolean" },
              "add": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
              }
            },
            "additionalProperties": false
          },
          "allowPreview": { "type": "boolean" },
          "provision": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
