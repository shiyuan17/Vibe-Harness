{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness Adapter Catalog",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 4 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "installMap", "instructionTarget", "instructionTemplate", "skillRoot", "supportedProfiles", "capabilities", "roleProjection", "hookEvents", "hookActivation", "evidence", "redZonePrefixes"],
        "properties": {
          "id": { "type": "string", "enum": ["codex", "claude", "gemini", "cursor", "qoder", "zcode", "antigravity", "opencode"] },
          "installMap": { "type": "string", "minLength": 1 },
          "instructionTarget": { "type": "string", "minLength": 1 },
          "instructionTemplate": { "type": "string", "minLength": 1 },
          "skillRoot": { "type": "string", "minLength": 1 },
          "projectConfig": {
            "type": "object",
            "properties": {
              "hooks": {
                "type": "object",
                "required": ["path", "target"],
                "properties": {
                  "path": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "target": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "mcp": {
                "type": "object",
                "required": ["path", "target"],
                "properties": {
                  "path": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "target": { "type": "string", "minLength": 1 },
                  "alternateTargets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                  "syntax": { "type": "string", "enum": ["json", "jsonc"] },
                  "serverFormat": { "type": "string", "enum": ["command-args-env", "opencode-local"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "supportedProfiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "capabilities": {
            "type": "object",
            "required": ["instructions", "skills", "hooks", "policy", "mcp", "sandbox", "memory", "plugin", "goals", "subagents"],
            "properties": {
              "instructions": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "skills": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "hooks": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "policy": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "mcp": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "sandbox": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "memory": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "plugin": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "goals": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "subagents": { "type": "string", "enum": ["unsupported", "preview", "stable"] }
            },
            "additionalProperties": false
          },
          "roleProjection": {
            "type": "object",
            "required": ["format", "targetRoot", "extension", "activation", "permissionEnforcement"],
            "properties": {
              "format": { "type": "string", "enum": ["codex-toml", "claude-markdown", "gemini-markdown", "cursor-markdown", "qoder-markdown", "zcode-plugin-markdown", "antigravity-markdown", "opencode-markdown"] },
              "targetRoot": { "type": "string", "minLength": 1 },
              "extension": { "type": "string", "enum": [".md", ".toml"] },
              "activation": { "type": "string", "enum": ["automatic", "manual"] },
              "permissionEnforcement": { "type": "string", "enum": ["native", "prompt-guarded"] }
            },
            "additionalProperties": false
          },
          "hookEvents": {
            "type": "object",
            "required": ["preToolUse", "permissionRequest", "stop"],
            "properties": {
              "preToolUse": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "permissionRequest": { "type": "string", "enum": ["unsupported", "preview", "stable"] },
              "stop": { "type": "string", "enum": ["unsupported", "preview", "stable"] }
            },
            "additionalProperties": false
          },
          "hookActivation": { "type": "string", "enum": ["manual-trust", "config-file", "unsupported"] },
          "evidence": {
            "type": "object",
            "required": ["status", "lastVerifiedAt", "hostVersion"],
            "properties": {
              "status": { "type": "string", "enum": ["verified", "configured-unverified", "preview"] },
              "lastVerifiedAt": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
              "hostVersion": { "type": "string" }
            },
            "additionalProperties": false
          },
          "redZonePrefixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
