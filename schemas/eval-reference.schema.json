{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness evaluation reference",
  "type": "object",
  "required": ["schemaVersion", "id", "approvedAt", "suite", "mode", "fingerprint", "capabilities", "overallScore", "criticalPassRate"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2] },
    "id": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "minLength": 1 },
    "suite": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "mode": { "type": "string", "enum": ["offline", "online"] },
    "proof": { "type": "string", "enum": ["contract-replay", "stub-behavioral", "online-canary"] },
    "fingerprint": { "type": "object", "required": ["suiteHash", "runner", "model", "agent", "configHash"], "properties": { "suiteHash": { "type": "string", "minLength": 1 }, "runner": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "agent": { "type": "string", "minLength": 1 }, "configHash": { "type": "string", "minLength": 1 }, "assets": { "type": "object", "required": ["aggregateHash", "groups"], "properties": { "aggregateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "groups": { "type": "object", "required": ["config", "hooks", "rules", "skills"], "properties": { "config": { "type": "object" }, "hooks": { "type": "object" }, "rules": { "type": "object" }, "skills": { "type": "object" } }, "additionalProperties": false } }, "additionalProperties": false } }, "additionalProperties": false },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "caseCount", "passedCount", "score"], "properties": { "id": { "type": "string", "minLength": 1 }, "caseCount": { "type": "integer", "minimum": 1 }, "passedCount": { "type": "integer", "minimum": 0 }, "score": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false } },
    "overallScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "criticalPassRate": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
