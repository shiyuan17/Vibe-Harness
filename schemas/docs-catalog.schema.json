{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "status", "language", "audiences"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["agent-rules", "user-guide", "contributor-guide", "architecture", "operations", "migration", "spec", "plan", "inventory", "changelog", "index"]
          },
          "status": {
            "type": "string",
            "enum": ["current", "implemented", "reference", "superseded", "completed"]
          },
          "language": { "type": "string", "enum": ["zh-CN", "en", "bilingual"] },
          "audiences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["agent", "user", "contributor", "maintainer", "auditor"] }
          },
          "supersededBy": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
