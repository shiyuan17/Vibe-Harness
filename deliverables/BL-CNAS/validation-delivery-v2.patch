+  let plan;
+  try {
+    plan = JSON.parse(output);
+  } catch {
+    throw new Error('Turbo typecheck dry run did not return valid JSON.');
+  }
+  if (!plan || !Array.isArray(plan.tasks)) {
+    throw new Error('Turbo typecheck dry run did not return a task list.');
+  }
+  const directories = new Set();
+  for (const task of plan.tasks) {
+    if (task?.task !== 'typecheck' || task.command === '<NONEXISTENT>')
+      continue;
+    if (typeof task.directory !== 'string' || !task.directory.trim()) {
+      throw new Error('Turbo typecheck task is missing its package directory.');
+    }
+    const directory = normalizePath(task.directory).replace(/\/+$/u, '');
+    const absolute = path.resolve(FRONTEND_ROOT, directory);
+    if (
+      path.isAbsolute(directory) ||
+      path.win32.isAbsolute(directory) ||
+      /^[a-z]:/iu.test(directory) ||
+      directory.split('/').includes('..') ||
+      (absolute !== FRONTEND_ROOT &&
+        !absolute.startsWith(`${FRONTEND_ROOT}${path.sep}`))
+    ) {
+      throw new Error(
+        `Turbo typecheck directory escapes the frontend: ${directory}`,
+      );
+    }
+    if (!existsSync(path.join(absolute, 'package.json'))) {
+      throw new Error(`Turbo typecheck package is missing: ${directory}`);
+    }
+    directories.add(normalizePath(path.relative(FRONTEND_ROOT, absolute)));
+  }
+  if (directories.size === 0) {
+    throw new Error('Turbo typecheck dry run selected no packages.');
+  }
+  return [...directories].toSorted((left, right) => left.localeCompare(right));
+}
+
+async function runTypecheckPackages(argv) {
+  const affected = argv.includes('--affected');
+  const unknown = argv.filter(
+    (argument) => argument.startsWith('--') && argument !== '--affected',
+  );
+  if (unknown.length > 0) {
+    throw new Error(`Unknown typecheck argument: ${unknown[0]}`);
+  }
+  const filters = argv.filter((argument) => argument !== '--affected');
+  const turboArgs = [
+    'x',
+    'turbo',
+    'run',
+    'typecheck',
+    ...(affected ? ['--affected'] : []),
+    ...filters.map(
+      (directory) => `--filter=...{./${normalizePath(directory)}}`,
+    ),
+    '--dry=json',
+  ];
+  const planned = spawnSync('bun', turboArgs, {
+    cwd: FRONTEND_ROOT,
+    encoding: 'utf8',
+    env: {
+      ...validationGitEnvironment(process.env, REPO_ROOT),
+      ...(affected
+        ? { TURBO_SCM_BASE: process.env.TURBO_SCM_BASE ?? 'origin/develop' }
+        : {}),
+    },
+    maxBuffer: 64 * 1024 * 1024,
+    timeout: 120_000,
+    shell: false,
+    stdio: ['ignore', 'pipe', 'pipe'],
+    windowsHide: true,
+  });
+  if (planned.stderr) process.stderr.write(planned.stderr);
+  if (planned.error) throw planned.error;
+  if (planned.status !== 0) return planned.status ?? 1;
+
+  let directories;
+  try {
+    directories = parseTypecheckDryRun(planned.stdout);
+  } catch (error) {
+    console.error(`[validation] typecheck plan rejected: ${error.message}`);
+    return 1;
+  }
+  for (const directory of directories) {
+    console.warn(`[validation] typecheck ${directory} started`);
+    const result = await runCommand(
+      'bun',
+      ['run', '--cwd', directory, 'typecheck'],
+      FRONTEND_ROOT,
+    );
+    console.warn(
+      `[validation] typecheck ${directory} exit=${result.exitCode} durationMs=${result.durationMs}`,
+    );
+    if (result.exitCode !== 0) return result.exitCode;
+  }
+  return 0;
+}
+
+/** 前端三条原子检查：显式路径贯穿 lint 与测试；typecheck 按所属包扩大。 */
+function frontendStages(paths, { escalate }) {
+  const frontendPaths = paths.filter((file) => existsSync(path.join(REPO_ROOT, file))).map((file) => toFrontendPath(file));
+  const explicit = frontendPaths.length > 0;
+  const lintArgs = explicit
+    ? [
+        'x',
+        'vsh',
+        'lint',
+        ...frontendPaths.filter((file) => !file.endsWith('.md')),
+      ]
+    : ['run', 'lint:changed'];
+  const testArgs = explicit
+    ? [
+        'run',
+        'test:changed',
+        '--',
+        '--paths',
+        ...paths.map((file) => toRepositoryPath(file)),
+      ]
+    : ['run', 'test:changed'];
+  return [
+    {
+      args: escalate ? ['run', 'lint'] : lintArgs,
+      command: 'bun',
+      cwd: FRONTEND_ROOT,
+      name: 'lint',
+      scope: frontendScope(escalate, explicit),
+    },
+    {
+      args: [
+        './scripts/validation-runner.mjs',
+        'typecheck-packages',
+        ...(escalate ? [] : affectedTypecheckFilters(paths)),
+      ],
+      command: 'bun',
+      cwd: FRONTEND_ROOT,
+      name: 'typecheck',
+      scope: escalate ? 'frontend-full' : 'explicit-packages-and-dependents',
+    },
+    {
+      args: escalate ? ['run', 'test:unit'] : testArgs,
+      command: 'bun',
+      cwd: FRONTEND_ROOT,
+      name: 'test',
+      scope: frontendScope(escalate, explicit),
+    },
+  ];
+}
+
+/** Turbo --affected 会重新选基线；显式 package filters 保持冻结路径并包含消费方。 */
+function affectedTypecheckFilters(paths) {
+  const packages = new Set();
+  for (const file of paths) {
+    let directory = path.dirname(path.resolve(REPO_ROOT, file));
+    while (
+      directory !== FRONTEND_ROOT &&
+      directory.startsWith(`${FRONTEND_ROOT}${path.sep}`)
+    ) {
+      if (existsSync(path.join(directory, 'package.json'))) break;
+      directory = path.dirname(directory);
+    }
+    if (
+      directory === FRONTEND_ROOT ||
+      !directory.startsWith(`${FRONTEND_ROOT}${path.sep}`)
+    )
+      return [];
+    packages.add(normalizePath(path.relative(FRONTEND_ROOT, directory)));
+  }
+  return [...packages].toSorted((left, right) => left.localeCompare(right));
+}
+
+/** 后端阶段：命中映射时聚焦，否则完整单测；迁移/POM 变更明确不产生 DM8 证据。 */
+function backendStages(backendPaths, { escalate }) {
+  const selectors = escalate ? null : backendTestSelectors(backendPaths);
+  const args = selectors
+    ? [
+        `-Dtest=${selectors.join(',')}`,
+        '-Dsurefire.failIfNoSpecifiedTests=true',
+        'test',
+      ]
+    : ['test'];
+  return [
+    {
+      args,
+      maven: true,
+      name: 'backend-test',
+      scope: selectors
+        ? `mapped-domains:${selectors.join(',')}`
+        : 'backend-full',
+    },
+  ];
+}
+
+const DOC_STAGE = Object.freeze({
+  args: ['run', 'check:docs-consistency'],
+  command: 'bun',
+  cwd: FRONTEND_ROOT,
+  name: 'docs-static',
+  scope: 'docs-consistency',
+});
+
+/** 契约定更后的只读一致性检查：不触发写盘 codegen，也不改写生成物。 */
+const CONTRACT_STAGE = Object.freeze({
+  args: ['run', 'mock:check:bridge-parity'],
+  cache: 'read-only',
+  command: 'bun',
+  cwd: FRONTEND_ROOT,
+  name: 'contract-parity',
+  scope: 'mock-bridge-parity（只读；未运行写盘 codegen）',
+});
+const CONTRACT_STANDARD_STAGE = Object.freeze({
+  args: ['run', 'check:openapi'],
+  command: 'bun',
+  cwd: FRONTEND_ROOT,
+  name: 'contract-openapi',
+  scope: 'affected-contract',
+});
+const MIGRATION_STANDARD_STAGE = Object.freeze({
+  args: [
+    '-Dtest=*MigrationTests',
+    '-Dsurefire.failIfNoSpecifiedTests=true',
+    'test',
+  ],
+  maven: true,
+  name: 'backend-migration',
+  scope: 'migration-contract',
+});
+
+async function runChanged(argv, { standard = false, atomic = null } = {}) {
+  const paths = parsePaths(argv);
+  const scope = collectScope(paths);
+  if (scope.empty && scope.requestedScope !== 'full') {
+    if (argv.includes('--plan')) {
+      console.log(`[validation:plan] ${JSON.stringify({ scope, selectedChecks: [], status: 'unverified', reason: 'empty-scope' })}`);
+      return 2;
+    }
+    const run = {
+      generatedAt: new Date().toISOString(),
+      lowerBound: 'empty-scope',
+      results: [],
+      scope,
+    };
+    await writeRun(run);
+    console.warn(
+      `[validation:summary] ${JSON.stringify(run)}\n[validation] 空变更范围；未执行验证，不构成完整通过证据。`,
+    );
+    return 1;
+  }
+
+  const buckets = classifyPaths(scope.files);
+  // 删除文件无法界定影响面，且 `test:changed --paths` 不接受不存在的路径：按桶整体扩大。
+  const deleted = classifyPaths(scope.deleted);
+  const escalateFrontend = false; // Deleted sources are resolved by test:changed against the frozen baseline/domain.
+  const escalateBackend = deleted.backend.length > 0;
+  const contractTouched =
+    buckets.contract.length > 0 ||
+    deleted.contract.length > 0;
