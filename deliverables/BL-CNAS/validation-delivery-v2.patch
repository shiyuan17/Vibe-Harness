+  if (buckets.operational.length) stages.push({
+    name: 'operational-static', command: 'node', cwd: FRONTEND_ROOT,
+    args: ['./scripts/validation-operational.mjs', ...buckets.operational],
+    scope: 'explicit-operational-inputs',
+  });
+  if (
+    !standard &&
+    (buckets.frontend.length > 0 || escalateFrontend || unknownEscalates)
+  ) {
+    stages.push(
+      ...frontendStages(buckets.frontend, {
+        escalate: escalateFrontend || unknownEscalates,
+      }),
+    );
+  }
+  // 契约检查廉价且只读：紧随前端检查之后、后端长测之前，避免反馈被后端耗时掩盖。
+  if (!standard && contractTouched) stages.push(CONTRACT_STAGE);
