+    scope, runId: VALIDATION_RUN_ID,
+  });
+}
+
+/**
+ * 档位入口：委派统一运行时执行 `validationCommands.tiers`。
+ * 本脚本不重新解释档位含义，避免与运行时产生第二套语义。
+ */
+async function runTier(tier, argv) {
