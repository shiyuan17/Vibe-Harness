-    ],
-    selectors: [
-      'com.blcnas.organization.OrganizationChangeImpactSliceTests',
-      'com.blcnas.organization.OrganizationWorkbenchTodoSourceTests',
-    ],
-  },
-  {
-    domain: 'organization',
-    prefixes: ['backend/src/main/java/com/blcnas/organization/'],
-    selectors: ['com.blcnas.organization.*Tests'],
-  },
-  {
-    domain: 'iam',
-    prefixes: ['backend/src/main/java/com/blcnas/iam/'],
-    selectors: ['com.blcnas.iam.*Tests', 'com.blcnas.iam.application.*Tests'],
