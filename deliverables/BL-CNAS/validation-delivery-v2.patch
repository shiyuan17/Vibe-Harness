-#!/usr/bin/env node
-/**
- * 按变更范围运行前端单测。
- *
- * 选择依据是 Vitest/Vite 自己的模块图：`vitest related <源文件...>`。它解析
- * tsconfig/vite 别名、重导出与传递依赖，比「同名用例 + 直接导入扫描」更接近真实
- * 影响面。实测（2026-09-28，vitest 4.1.10）：
- *   --paths apps/web/src/api/organization/check-in.ts
- *   静态扫描 → 1 个测试文件；vitest related → 4 个（多出 router/views 的传递依赖）。
- * 单次 `vitest related` 约 50 秒（含执行），`vitest list` 全量收集约 307 秒，因此
- * 不做全量收集，只在需要时按分组回退完整集合。
- *
- * 用法：
- *   bun run --cwd frontend test:changed
- *   bun run --cwd frontend test:changed -- --since origin/develop
- *   bun run --cwd frontend test:changed -- --paths <文件...>
- *   bun run --cwd frontend test:changed -- --dry-run
- *
- * 约定：
- * - 默认基准 ref 为 `origin/develop`（与 `worktree.baseRef` 一致），ref 缺失时显式报错，
- *   不静默回退全量。
- * - 变更集合 = 基准 ref 与 HEAD 的 merge-base 到工作区（含暂存与未跟踪文件）。
- * - 范围分两组执行：根配置跑 web 侧用例；`apps/mock-server` 与
- *   `packages/prototype-contracts` 的用例由专用配置 `apps/mock-server/vitest.config.ts`
- *   收集，根配置显式排除了它们，所以这两组必须分开跑，否则相关用例会被静默跳过。
- * - `--paths` 用于 fan-in / 合并后复核（此时按变更范围会选中空集合）。
- * - 影响面无法界定时按分组回退完整集合，而不是静默跳过：vitest 配置变更、锁文件变更、
- *   删除文件、`vitest related` 选不出用例或执行失败都会触发回退。
- * - 空变更范围立即退出 0 并打印「未产生行为证据」；这不是通过证据。
- */
-import { spawn } from 'node:child_process';
-import { readFile, stat } from 'node:fs/promises';
-import path from 'node:path';
-import process from 'node:process';
-import { fileURLToPath } from 'node:url';
-
-const SCRIPT_DIR = path.dirname(fileURLToPath(import.meta.url));
-const FRONTEND_ROOT = path.resolve(SCRIPT_DIR, '..');
-const REPO_ROOT = path.resolve(FRONTEND_ROOT, '..');
-const DEFAULT_BASE_REF = 'origin/develop';
-/** 专用 vitest 配置覆盖的目录（根配置把这些测试显式排除）。 */
-const MOCK_SCOPE_PREFIXES = [
-  'apps/mock-server/',
-  'packages/prototype-contracts/',
-];
-const MOCK_CONFIG_PATH = 'apps/mock-server/vitest.config.ts';
-const TEST_FILE_PATTERN = /\.(?:test|spec)\.(?:c|m)?[jt]sx?$/u;
-const VITEST_CONFIG_PATTERN = /(?:^|\/)vitest\.config\.[cm]?[jt]s$/u;
-const LOCKFILE_PATTERN =
-  /^frontend\/(?:bun\.lockb?|package-lock\.json|pnpm-lock\.yaml|yarn\.lock)$/u;
-const SOURCE_EXTENSIONS = new Set([
-  '.cjs',
-  '.cts',
-  '.js',
-  '.jsx',
-  '.mjs',
-  '.mts',
-  '.ts',
-  '.tsx',
-  '.vue',
-]);
-/** 根配置与 mock 专用配置各跑一次 related，因此一次最多两个分组调用。 */
-const GROUPS = Object.freeze({
-  mock: { configPath: MOCK_CONFIG_PATH, label: 'mock-server+contracts' },
-  web: { configPath: undefined, label: 'web' },
-});
-/** Windows 命令行长度上限约 8191 字符，留出余量后分片调用。 */
-const MAX_ARG_CHARS = 6000;
-const NO_TESTS_PATTERN = /No test files found|passWithNoTests/iu;
-
-function parseArgs(argv) {
-  const options = {
-    baseRef: DEFAULT_BASE_REF,
-    dryRun: false,
-    paths: [],
-    passthrough: [],
-  };
-  for (let index = 0; index < argv.length; index += 1) {
-    const flag = argv[index];
-    if (flag === '--paths') {
-      let next = argv[index + 1];
-      while (next !== undefined && !next.startsWith('--')) {
-        options.paths.push(next);
-        index += 1;
-        next = argv[index + 1];
-      }
-      if (options.paths.length === 0) {
-        throw new Error('Missing value for --paths');
-      }
-      continue;
-    }
-    if (flag === '--since') {
-      const value = argv[index + 1];
-      if (value === undefined || value.startsWith('--')) {
-        throw new Error('Missing value for --since');
-      }
-      options.baseRef = value;
-      index += 1;
-      continue;
-    }
-    if (flag === '--dry-run') {
-      options.dryRun = true;
-      continue;
-    }
-    throw new Error(`Unknown argument: ${flag}`);
-  }
-  return options;
-}
-
-/** 运行 git 命令，返回按行切分的 stdout。 */
-function gitLines(args) {
-  return new Promise((resolve, reject) => {
-    // `core.quotepath=false`：否则非 ASCII 路径会被转义成 "\346..."，既无法匹配
-    // 分组前缀，也会被误判成「无法界定影响面」。
-    const child = spawn('git', ['-c', 'core.quotepath=false', ...args], {
-      cwd: REPO_ROOT,
-      shell: false,
-      windowsHide: true,
-    });
-    let stdout = '';
-    let stderr = '';
-    child.stdout.on('data', (chunk) => {
-      stdout += chunk;
-    });
-    child.stderr.on('data', (chunk) => {
-      stderr += chunk;
-    });
-    child.on('error', reject);
-    child.on('close', (code) => {
-      const lines = stdout
-        .split('\n')
-        .map((line) => line.trim())
-        .filter(Boolean);
-      if (code === 0) {
-        resolve(lines);
-        return;
-      }
-      reject(new Error(`git ${args.join(' ')} failed: ${stderr.trim()}`));
-    });
-  });
-}
-
-/** 解析基准 ref 与 HEAD 的 merge-base；ref 缺失时抛错而不是回退全量。 */
-async function resolveMergeBase(baseRef) {
-  const existing = await gitLines([
-    'rev-parse',
-    '--verify',
-    '--quiet',
-    `${baseRef}^{commit}`,
-  ]);
-  if (existing.length === 0) {
-    throw new Error(
-      `基准 ref ${baseRef} 不存在。请先 fetch（git fetch origin develop）或显式传 --since <ref>。`,
-    );
-  }
-  const [mergeBase] = await gitLines(['merge-base', 'HEAD', baseRef]);
-  if (!mergeBase) {
-    throw new Error(`无法计算 HEAD 与 ${baseRef} 的 merge-base。`);
-  }
-  return mergeBase;
-}
-
-/** 收集基准 ref 以来的变更文件（含暂存、未暂存与未跟踪），返回仓库相对路径。 */
-async function collectChangedFiles(mergeBase) {
-  const tracked = await gitLines(['diff', '--name-only', mergeBase, '--']);
-  const untracked = await gitLines([
-    'ls-files',
-    '--others',
-    '--exclude-standard',
-    '--full-name',
-  ]);
-  return [...new Set([...tracked, ...untracked])].toSorted((a, b) =>
-    a.localeCompare(b),
-  );
-}
-
-/** 基准 ref 以来被删除的文件（仓库相对路径）。 */
-async function collectDeletedFiles(mergeBase) {
-  const deleted = await gitLines([
-    'diff',
-    '--name-only',
-    '--diff-filter=D',
-    mergeBase,
-    '--',
-  ]);
-  return deleted.toSorted((a, b) => a.localeCompare(b));
-}
-
-/** 把仓库相对或绝对路径转换到 frontend/ 下的相对路径；不在 frontend/ 内返回 null。 */
-function toFrontendRelative(file) {
-  const normalized = file.replaceAll('\\', '/');
-  const absolute = path.isAbsolute(normalized)
-    ? normalized
-    : path.resolve(REPO_ROOT, normalized).replaceAll('\\', '/');
-  const frontendRoot = FRONTEND_ROOT.replaceAll('\\', '/');
-  const comparable = (value) =>
-    process.platform === 'win32' ? value.toLowerCase() : value;
-  if (!comparable(absolute).startsWith(`${comparable(frontendRoot)}/`)) {
-    return null;
-  }
-  return absolute.slice(frontendRoot.length + 1);
-}
-
-/**
- * 只保留前端源文件，并转换为相对 frontend/ 的路径。
- * 输入可以是仓库相对路径，也可以是绝对路径（`--paths` 场景）。
- */
-function toFrontendSources(files) {
-  const result = [];
-  for (const file of files) {
-    const relative = toFrontendRelative(file);
-    if (relative === null) continue;
-    if (relative.includes('node_modules/')) continue;
-    // e2e 目录属于 Playwright 旅程，不在 vitest 单测范围内（由 CI 的 e2e 作业覆盖）。
-    if (relative.includes('/e2e/') || relative.startsWith('e2e/')) continue;
-    if (relative.includes('playwright.')) continue;
-    const lastDot = relative.lastIndexOf('.');
-    if (lastDot === -1) continue;
-    if (!SOURCE_EXTENSIONS.has(relative.slice(lastDot).toLowerCase())) continue;
-    result.push(relative);
-  }
-  return [...new Set(result)].toSorted((a, b) => a.localeCompare(b));
-}
-
-/** 判断是否为单测文件（e2e 由 Playwright 覆盖，不计入 vitest 范围）。 */
-function isTestFile(file) {
-  return TEST_FILE_PATTERN.test(file) && !file.includes('/e2e/');
-}
-
-/** 源文件归属的分组：mock-server / prototype-contracts 走专用配置，其余走根配置。 */
-function groupOf(file) {
-  return MOCK_SCOPE_PREFIXES.some((prefix) => file.startsWith(prefix))
-    ? 'mock'
-    : 'web';
-}
-
-/**
- * 影响面无法由 `vitest related` 界定时必须整体回退的原因。
- *
- * 每条原因带 group：`all` 表示两组都回退，`web`/`mock` 只回退对应分组。宁可多跑，
- * 也不要因为选择器看不见依赖而放行。
- */
-function escalationReasons({ changedFiles, deletedFiles, hasSources }) {
-  const reasons = [];
-  for (const file of changedFiles) {
-    if (VITEST_CONFIG_PATTERN.test(file)) {
-      reasons.push({ group: 'all', text: `vitest 配置变更：${file}` });
-    } else if (LOCKFILE_PATTERN.test(file)) {
-      reasons.push({ group: 'all', text: `锁文件变更：${file}` });
-    }
-  }
-  for (const file of deletedFiles) {
-    const relative = toFrontendRelative(file);
-    if (relative === null || relative.includes('node_modules/')) continue;
-    if (isTestFile(relative)) continue; // Removing a test is not a reason to execute every remaining test.
-    reasons.push({ group: groupOf(relative), text: `删除文件：${relative}` });
-  }
-  if (!hasSources && changedFiles.length > 0) {
-    reasons.push({ group: 'all', text: '变更集合不含可解析的前端源文件' });
-  }
-  const seen = new Set();
-  return reasons.filter((reason) => {
-    const key = `${reason.group}\u0000${reason.text}`;
-    if (seen.has(key)) return false;
-    seen.add(key);
-    return true;
-  });
-}
-
-function chunkByLength(items, maxChars) {
-  const chunks = [];
-  let current = [];
-  let length = 0;
-  for (const item of items) {
-    if (current.length > 0 && length + item.length + 1 > maxChars) {
-      chunks.push(current);
-      current = [];
-      length = 0;
-    }
-    current.push(item);
-    length += item.length + 1;
-  }
-  if (current.length > 0) chunks.push(current);
-  return chunks;
-}
-
-/** 取不含目录与扩展名的文件名。 */
-function baseName(file) {
-  const name = file.slice(file.lastIndexOf('/') + 1);
-  const dot = name.indexOf('.');
-  return dot === -1 ? name : name.slice(0, dot);
-}
-
-function stripModuleSuffix(file) {
-  const withoutQuery = file.split(/[?#]/u, 1)[0];
-  const withoutExtension = withoutQuery.replace(
-    /\.(?:c|m)?[jt]sx?$|\.vue$/u,
-    '',
-  );
-  return withoutExtension.endsWith('/index')
-    ? withoutExtension.slice(0, -'/index'.length)
-    : withoutExtension;
-}
-
-/** Expand an empty related selection to test files in the affected source domain only. */
-function affectedDomainTests(sources, tests, group) {
-  const domains = new Set(
-    sources.map((source) => {
-      const segments = source.split('/');
-      return segments.length >= 5 &&
-        segments[0] === 'apps' &&
-        segments[1] === 'web' &&
-        segments[2] === 'src'
-        ? `${segments.slice(0, 5).join('/')}/`
-        : `${path.posix.dirname(source)}/`;
-    }),
-  );
-  return tests.filter(
-    (file) =>
-      isTestFile(file) &&
-      groupOf(file) === group &&
-      [...domains].some((domain) => file.startsWith(domain)),
-  );
-}
-
-function extractModuleSpecifiers(source) {
-  const specifiers = new Set();
-  const patterns = [
-    /\b(?:export|import)\s+(?:[^'"]*?\s+from\s+)?['"]([^'"]+)['"]/gu,
-    /\b(?:import|require)\s*\(\s*['"]([^'"]+)['"]\s*\)/gu,
-  ];
-  for (const pattern of patterns) {
-    for (const match of source.matchAll(pattern)) specifiers.add(match[1]);
-  }
-  return specifiers;
-}
-
-function resolveModuleSpecifier(testFile, specifier) {
-  if (specifier.startsWith('.')) {
-    return stripModuleSuffix(
-      path.posix.normalize(
-        path.posix.join(path.posix.dirname(testFile), specifier),
-      ),
-    );
-  }
-  if (specifier.startsWith('#/')) {
-    return stripModuleSuffix(`apps/web/src/${specifier.slice(2)}`);
-  }
-  if (specifier.startsWith('frontend/')) {
-    return stripModuleSuffix(toFrontendRelative(specifier) ?? specifier);
-  }
-  return stripModuleSuffix(specifier);
-}
-
-export function testImportsSource(testFile, testSource, sourceFile) {
-  const normalizedSource = stripModuleSuffix(sourceFile);
-  return [...extractModuleSpecifiers(testSource)].some(
-    (specifier) =>
-      resolveModuleSpecifier(testFile, specifier) === normalizedSource,
-  );
-}
-
-/** 列出 frontend/ 下所有跟踪与未跟踪文件（相对 frontend/ 的路径）。 */
-async function listFrontendFiles() {
-  const files = await gitLines([
-    'ls-files',
-    '--cached',
-    '--others',
-    '--exclude-standard',
-    '--full-name',
-    '--',
-    'frontend',
-  ]);
-  return files
-    .map((file) => toFrontendRelative(file))
-    .filter((file) => file !== null);
-}
-
-/**
- * 静态估算（--dry-run 用）：同名用例 + 直接导入扫描。
- * 只用于预览；真正执行时以 `vitest related` 的模块图为准，因此估算值只看下限。
- */
-async function staticEstimate(sources) {
-  const selected = new Set();
-  const plainSources = [];
-  for (const file of sources) {
-    if (isTestFile(file)) selected.add(file);
-    else plainSources.push(file);
-  }
-  if (plainSources.length === 0) {
-    return [...selected].toSorted((a, b) => a.localeCompare(b));
-  }
-  const frontendFiles = await listFrontendFiles();
-  const tests = frontendFiles.filter((file) => isTestFile(file));
-  for (const source of plainSources) {
-    const name = baseName(source);
-    for (const test of tests) {
-      if (baseName(test) === name) selected.add(test);
-    }
-  }
-  for (const test of tests) {
-    const testSource = await readFile(path.join(FRONTEND_ROOT, test), 'utf8');
-    if (
-      plainSources.some((source) => testImportsSource(test, testSource, source))
-    ) {
-      selected.add(test);
-    }
-  }
-  return [...selected].toSorted((a, b) => a.localeCompare(b));
-}
-
-/** 执行一次 vitest，把 stdout/stderr 交给调用方判定。 */
-function runVitest(args) {
-  return new Promise((resolve, reject) => {
-    const startedAt = Date.now();
-    const child = spawn(
-      process.execPath,
-      [
-        path.join(FRONTEND_ROOT, 'node_modules', 'vitest', 'vitest.mjs'),
-        ...args,
-      ],
-      {
-        cwd: FRONTEND_ROOT,
-        shell: false,
-        stdio: ['ignore', 'pipe', 'pipe'],
-        windowsHide: true,
-      },
-    );
-    let stdout = '';
-    let stderr = '';
-    child.stdout.on('data', (chunk) => {
-      stdout += chunk;
-    });
-    child.stderr.on('data', (chunk) => {
-      stderr += chunk;
-    });
-    child.on('error', reject);
-    child.on('close', (code) => {
-      resolve({
-        code: code ?? 1,
-        durationMs: Date.now() - startedAt,
-        stderr,
-        stdout,
-      });
-    });
-  });
-}
-
-/** 把子进程输出转发到终端，保持失败原因可见。 */
-function relay(result) {
-  if (result.stdout) process.stdout.write(result.stdout);
-  if (result.stderr) process.stderr.write(result.stderr);
-}
-
-function relatedArgs(group, sources, passthrough) {
-  const args = ['related', ...sources];
-  const { configPath } = GROUPS[group];
-  if (configPath === undefined) args.push('--dom');
-  else args.push('--config', configPath);
-  args.push(...passthrough);
-  return args;
-}
-
-function fullArgs(group, passthrough) {
-  const args = ['run'];
-  const { configPath } = GROUPS[group];
-  if (configPath === undefined) args.push('--dom');
-  else args.push('--config', configPath);
-  return [...args, ...passthrough];
-}
-
-/**
- * 运行一个分组：默认用 `vitest related` 按模块图选用例。
- * 选不出用例时按分组回退完整集合，并记录回退原因。
- */
-async function runGroup(group, payload) {
-  const { escalateBecause, passthrough, sources } = payload;
-  const label = GROUPS[group].label;
-  if (escalateBecause || sources.length === 0) {
-    const reason = escalateBecause ?? '分组内没有可解析源文件';
-    console.warn(
-      `[test:changed] ${label}：无法界定影响面（${reason}），回退完整集合。`,
-    );
-    const result = await runVitest(fullArgs(group, passthrough));
-    relay(result);
-    return {
-      durationMs: result.durationMs,
-      exitCode: result.code,
-      mode: 'full',
-      reason,
-    };
-  }
-  // Windows 的单条命令行上限约 8k 字符；变更面较大时按长度分片，避免 related 调用
-  // 直接 E2BIG 失败。分片只影响调用次数，不改变「以模块图选集」的语义。
-  const chunks = chunkByLength(sources, MAX_ARG_CHARS);
-  const estimate = await staticEstimate(sources);
-  console.warn(
-    `[test:changed] ${label}：related 输入 ${sources.length} 个源文件，静态下限 ${estimate.length} 个测试文件；模块图为实际选择依据。`,
-  );
-  const relatedResults = [];
-  let emptySelection = false;
-  for (const chunk of chunks) {
-    const related = await runVitest(relatedArgs(group, chunk, passthrough));
-    relay(related);
-    relatedResults.push(related);
-    // `vitest related` 选不中用例时退出码是 0（“No test files found”），这正是
-    // 需要拦下的假通过：先看输出，再看退出码。
-    if (NO_TESTS_PATTERN.test(`${related.stdout}${related.stderr}`)) {
-      emptySelection = true;
-    }
-  }
-  const relatedMs = relatedResults.reduce(
-    (total, item) => total + item.durationMs,
-    0,
-  );
-  if (emptySelection) {
-    const affected = affectedDomainTests(
-      sources,
-      await listFrontendFiles(),
-      group,
-    );
-    if (affected.length === 0) {
-      console.error(
-        `[test:changed] ${label}：related 空选择且受影响域无测试；覆盖缺口，检查失败。`,
-      );
-      return {
-        durationMs: relatedMs,
-        exitCode: 1,
-        mode: 'coverage-gap',
-        reason: '相关测试及受影响域测试均为空',
-        selectedFiles: 0,
-      };
-    }
-    console.warn(
-      `[test:changed] ${label}：related 空选择（覆盖缺口），扩大到受影响域 ${affected.length} 个测试文件。`,
-    );
-    const fallback = await runVitest([
-      'run',
-      ...affected,
-      ...(GROUPS[group].configPath
-        ? ['--config', GROUPS[group].configPath]
-        : ['--dom']),
-      ...passthrough,
-    ]);
-    relay(fallback);
-    return {
-      durationMs: relatedMs + fallback.durationMs,
-      exitCode: fallback.code,
-      mode: 'domain',
-      reason: 'vitest related 未选中用例',
-      selectedFiles: affected.length,
-    };
-  }
-  const failed = relatedResults.find((item) => item.code !== 0);
-  return {
-    durationMs: relatedMs,
-    exitCode: failed ? failed.code : 0,
-    mode: 'related',
-    reason: null,
-    selectedFilesLowerBound: estimate.length,
-  };
-}
-
-async function missingExplicitPaths(sources) {
-  const missing = [];
-  for (const source of sources) {
-    try {
-      await stat(path.join(FRONTEND_ROOT, source));
-    } catch {
-      missing.push(source);
-    }
-  }
-  return missing;
-}
-
-function groupReasonsFor(reasons, group) {
-  return reasons
-    .filter((reason) => reason.group === 'all' || reason.group === group)
-    .map((reason) => reason.text);
-}
-
-async function main() {
-  const options = parseArgs(process.argv.slice(2));
-  let scopeLabel;
-  let changedFiles;
-  let deletedFiles;
-  if (options.paths.length > 0) {
-    scopeLabel = `显式路径（${options.paths.length} 个输入）`;
-    changedFiles = [...options.paths];
-    deletedFiles = [];
-  } else {
-    const mergeBase = await resolveMergeBase(options.baseRef);
-    scopeLabel = `${options.baseRef}（merge-base ${mergeBase.slice(0, 9)}）`;
-    changedFiles = await collectChangedFiles(mergeBase);
-    deletedFiles = await collectDeletedFiles(mergeBase);
-  }
-
-  const allSources = toFrontendSources(changedFiles);
-  /*
-   * `--paths` 是人工输入，路径打错属于调用错误，必须显式报错；
-   * 变更集里被删除的源文件同样解析不出文件，但那是正常的重构结果：
-   * 它已由 `escalationReasons` 按分组触发「回退完整集合」，不能在此直接中断
-   * （否则任何删除源文件的改动都无法运行本检查）。
-   */
-  if (options.paths.length > 0) {
-    const missing = await missingExplicitPaths(allSources);
-    if (missing.length > 0) {
-      throw new Error(`显式路径不存在，无法界定影响面：${missing.join(', ')}`);
-    }
-  }
-  const frontendChanged = changedFiles.filter(
-    (file) => toFrontendRelative(file) !== null,
-  );
-  if (frontendChanged.length === 0) {
-    console.error(
-      `[test:changed] 范围：${scopeLabel}；无前端变更，空选择不构成通过。`,
-    );
-    process.exitCode = 1;
-    return;
-  }
-  const reasons = escalationReasons({
-    changedFiles: frontendChanged,
-    deletedFiles,
-    hasSources: allSources.length > 0,
-  });
-  const byGroup = { mock: [], web: [] };
