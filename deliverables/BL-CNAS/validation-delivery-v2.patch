+    name: 'backend-unit',
+    scope: 'backend-full',
+  },
+  'backend-verify': {
+    args: ['verify'],
+    name: 'backend-verify',
+    scope: 'backend-verify',
+  },
+});
+
+/**
+ * dm-it 档的凭据判空契约：与 `.gitlab-ci.yml` 的 dm-it shadow 作业、ADR-0007 §3
