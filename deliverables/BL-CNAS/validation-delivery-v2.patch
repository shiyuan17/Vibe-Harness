+  const plan = { ...scope, selectedChecks: selected, excludedDomains: {
+    backend: !selected.some((stage) => stage.maven),
+    contract: !contractTouched && !unknownEscalates,
+  }, coverageGaps: unknownEscalates ? [] : buckets.unknown,
+  expansionReasons: unknownEscalates ? ['explicit-full'] : escalateBackend ? ['deleted-backend-source'] : [],
+  reuse: 'atomic Harness receipts; aggregate changed is not deterministic' };
