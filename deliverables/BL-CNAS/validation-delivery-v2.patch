-#!/usr/bin/env node
-/**
- * BL-CNAS 的原子验证执行器。
- *
- * 职责边界：
- * - 本脚本只执行**原子检查**（lint / typecheck / test / backend 测试），并按变更
- *   范围选择要跑的子集。它不重新实现档位语义：档位命令集合的唯一真值源是
- *   `vibe-harness.config.json` 的 `validationCommands.tiers`，`verify:standard`
- *   直接转交统一运行时执行，避免「聚合入口调用聚合入口」形成递归。
- * - 前后端分流：`frontend/**` 只触发前端检查；`backend/**` 使用仓库内 Maven Wrapper
- *   （Windows `mvnw.cmd`，其他平台 `./mvnw`），不依赖全局 Maven 与子目录 `pom.xml`
- *   被当成根项目；纯文档变更不启动行为测试。
- * - 每个阶段记录时长、范围、缓存与失败原因，供 `verify-changed-runs.jsonl` 复盘。
- *
- * 用法：
- *   bun run --cwd frontend verify:changed              # 按 origin/develop 的变更范围
- *   bun run --cwd frontend verify:changed -- --paths <文件...>
- *   bun run --cwd frontend verify:standard -- --reason merge-boundary
- *   node scripts/validation-runner.mjs backend-unit    # 供档位配置引用的原子模式
- *   node scripts/validation-runner.mjs preflight       # 仅检查工具链、依赖和缓存
- */
-import { spawn, spawnSync } from 'node:child_process';
-import { randomUUID } from 'node:crypto';
-import { existsSync, readdirSync, readFileSync, realpathSync } from 'node:fs';
-import { appendFile, mkdir, open, readFile, unlink } from 'node:fs/promises';
-import { createRequire } from 'node:module';
-import path from 'node:path';
-import process from 'node:process';
-import { fileURLToPath } from 'node:url';
-
-const SCRIPT_DIR = path.dirname(fileURLToPath(import.meta.url));
-const FRONTEND_ROOT = path.resolve(SCRIPT_DIR, '..');
-const REPO_ROOT = path.resolve(FRONTEND_ROOT, '..');
-const BACKEND_ROOT = path.join(REPO_ROOT, 'backend');
-const RUNS_PATH = path.resolve(
-  REPO_ROOT,
-  '.vibe-harness',
-  'artifacts',
-  'verify-changed-runs.jsonl',
-);
-/** Windows 用 `mvnw.cmd`，其他平台用 `./mvnw`；两者都在 backend/ 下执行。 */
-const MAVEN_WRAPPER = process.platform === 'win32' ? 'mvnw.cmd' : './mvnw';
-/**
- * 源码域 → 后端测试集合的显式映射；未知或部分覆盖仍扩大。
- *
- * Surefire 的 `-Dtest=<模式>` 选中类名匹配的测试；命中多个域时取并集。未命中任何
- * 映射的后端路径（公共基础设施、通用配置、POM、迁移脚本、测试资源）回退完整后端
- * 单测，宁可多跑，也不要因为映射缺口漏检。
- */
-const BACKEND_TEST_MAPPING = [
-  {
-    domain: 'organization-change-impact',
-    prefixes: [
-      'backend/src/main/java/com/blcnas/organization/application/ChangeImpactAssessment',
