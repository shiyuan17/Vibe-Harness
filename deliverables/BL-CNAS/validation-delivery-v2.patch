+    if (argv.includes('--plan')) {
+      console.log(`[validation:plan] ${JSON.stringify({ scope, selectedChecks: [], status: 'not_selected' })}`);
+      return 0;
+    }
+    await writeRun({
+      generatedAt: new Date().toISOString(),
+      results: [],
+      scope,
+      status: 'not_applicable',
+    });
+    console.warn(
+      '[validation] standard-slice：无适用的额外契约/迁移检查；quick 的实测结果仍是本次证据。',
+    );
