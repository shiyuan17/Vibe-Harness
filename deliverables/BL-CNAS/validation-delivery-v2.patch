index 0000000000000000000000000000000000000000..3294a25a6d29e0661e7df7e00a551107888f6112
--- /dev/null
+++ b/frontend/scripts/validation-git-environment.mjs
@@ -0,0 +1,11 @@
+import path from 'node:path';
+
+/** Keep the hook's alternate index, but never let a frontend cwd redefine Git's root. */
+export function validationGitEnvironment(environment = process.env, hookRoot = process.cwd()) {
+  return {
+    ...environment,
+    GIT_WORK_TREE: hookRoot,
+    ...(environment.GIT_DIR ? { GIT_DIR: path.resolve(hookRoot, environment.GIT_DIR) } : {}),
+    ...(environment.GIT_INDEX_FILE ? { GIT_INDEX_FILE: path.resolve(hookRoot, environment.GIT_INDEX_FILE) } : {}),
+  };
+}
diff --git a/frontend/scripts/validation-scope-regression.test.mjs b/frontend/scripts/validation-scope-regression.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..03a8af56256a6d442206fea41402be5c6bd67045
--- /dev/null
+++ b/frontend/scripts/validation-scope-regression.test.mjs
@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { spawnSync } from 'node:child_process';
+import { backendTestSelectors, classifyPaths, collectScope, frontendStages } from './validation-runner.mjs';
+import { escalationReasons, pageContractTests } from './vitest-changed.mjs';
+import { validationGitEnvironment } from './validation-git-environment.mjs';
+const page = 'frontend/apps/web/src/views/facility/sensor-management.vue';
+const pageTest = page.replace('.vue', '.test.ts');
+test('task paths do not absorb pre-existing operational changes', () => {
+  const scope = collectScope([page, pageTest], { exists: () => true });
+  const buckets = classifyPaths(scope.files);
+  assert.equal(buckets.frontend.length, 2);
+  assert.equal(buckets.backend.length, 0);
+  assert.equal(buckets.unknown.length, 0);
+  const stages = frontendStages(scope.files, { escalate: false });
+  assert.equal(stages.some((stage) => stage.maven), false);
+  assert.deepEqual(stages.map((stage) => stage.name), ['lint', 'typecheck', 'test']);
+});
+
+test('ordinary organization test changes select their own classes instead of all backend tests', () => {
+  assert.deepEqual(backendTestSelectors([
+    'backend/src/test/java/com/blcnas/organization/TrainingCommandSliceTests.java',
+    'backend/src/test/java/com/blcnas/organization/OrganizationEducationRecordSliceTests.java',
+  ]), ['com.blcnas.organization.OrganizationEducationRecordSliceTests', 'com.blcnas.organization.TrainingCommandSliceTests']);
+  assert.equal(backendTestSelectors(['backend/pom.xml']), null, 'shared build inputs retain broader coverage');
+});
+
+test('known test configurations expand only the consuming frontend group', () => {
+  const reasons = (file) => escalationReasons({ changedFiles: [file], deletedFiles: [], hasSources: true });
+  assert.equal(reasons('frontend/vitest.config.ts')[0].group, 'web');
+  assert.equal(reasons('frontend/apps/mock-server/vitest.config.ts')[0].group, 'mock');
+  assert.equal(reasons('frontend/bun.lock')[0].group, 'all');
+});
+
+test('hook Git root and alternate index remain rooted when a child changes directories', () => {
+  const root = process.cwd();
+  const scoped = validationGitEnvironment({ GIT_DIR: '.git', GIT_INDEX_FILE: 'alternate-index' }, root);
+  assert.equal(scoped.GIT_WORK_TREE, root);
+  assert.equal(scoped.GIT_DIR, `${root}${root.includes('\\') ? '\\' : '/'}.git`);
+  assert.ok(scoped.GIT_INDEX_FILE.endsWith('alternate-index'));
+});
+test('operational files are classified; unknown files remain a coverage gap', () => {
+  const buckets = classifyPaths([page, '.infisical.json', 'scripts/simulator.ps1', 'unclassified.bin']);
+  assert.equal(buckets.operational.length, 2);
+  assert.equal(buckets.backend.length, 0);
+  assert.deepEqual(buckets.unknown, ['unclassified.bin']);
+});
+test('file-reading page contracts have an explicit Vue dependency', () => {
+  assert.deepEqual(pageContractTests([page.slice('frontend/'.length)]), [pageTest.slice('frontend/'.length)]);
+});
+test('changed plan is read-only and does not add backend or contract stages', () => {
+  const result = spawnSync(process.execPath, [new URL('./validation-runner.mjs', import.meta.url).pathname.replace(/^\/([A-Za-z]:)/u, '$1'),
+    'changed', '--plan', '--paths', page, pageTest], { encoding: 'utf8', windowsHide: true });
+  assert.equal(result.status, 0, result.stderr);
+  const line = result.stdout.split('\n').find((item) => item.startsWith('[validation:plan] '));
+  const plan = JSON.parse(line.slice('[validation:plan] '.length));
+  assert.equal(plan.mode, 'explicit-paths');
+  assert.deepEqual(plan.selectedChecks.map((stage) => stage.name), ['lint', 'typecheck', 'test']);
+  assert.deepEqual(plan.coverageGaps, []);
+});
