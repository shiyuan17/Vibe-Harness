@@ -0,0 +1,17 @@
+import { readFileSync } from 'node:fs';
+import { spawnSync } from 'node:child_process';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+for (const file of process.argv.slice(2)) {
+  if (file === '.infisical.json') {
+    // Parse only; never print the content or credentials.
+    JSON.parse(readFileSync(path.join(root, file), 'utf8'));
+  } else if (file === 'scripts/simulator.ps1') {
+    if (process.platform !== 'win32') throw new Error('PowerShell syntax check requires a Windows runner; not backend/full evidence');
+    const result = spawnSync('powershell.exe', ['-NoProfile', '-NonInteractive', '-File',
+      path.join(root, 'frontend/scripts/validation-powershell.ps1'), path.join(root, file)],
+    { windowsHide: true, stdio: 'inherit' });
+    if (result.status !== 0) process.exitCode = 1;
+  } else throw new Error('Unregistered operational input');
+}
