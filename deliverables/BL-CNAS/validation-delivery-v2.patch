-function parsePaths(argv) {
-  const paths = [];
-  for (let index = 0; index < argv.length; index += 1) {
-    if (argv[index] !== '--paths') {
-      throw new Error(`Unknown argument: ${argv[index]}`);
-    }
-    index += 1;
-    while (index < argv.length && !argv[index].startsWith('--')) {
-      paths.push(argv[index]);
-      index += 1;
-    }
-    index -= 1;
-  }
-  if (argv.includes('--paths') && paths.length === 0) {
-    throw new Error('Missing value for --paths');
-  }
-  return paths;
-}
-
-function parseReason(argv) {
-  const index = argv.indexOf('--reason');
-  const reason = index === -1 ? '' : argv[index + 1]?.trim();
-  if (!reason || reason.startsWith('--')) {
-    throw new Error(
-      'verify:standard requires --reason <merge-boundary|commit-boundary|targeted-regression>.',
-    );
-  }
-  return reason;
-}
-
-function gitLines(args) {
-  // `core.quotepath=false`：默认转义会把非 ASCII 路径写成 "\346..."，导致文档等
-  // 路径被误判成 unknown 并触发全量升级。
-  const result = spawnSync('git', ['-c', 'core.quotepath=false', ...args], {
-    cwd: REPO_ROOT,
-    encoding: 'utf8',
-    shell: false,
-    windowsHide: true,
-  });
-  if (result.status !== 0) {
-    throw new Error(`git ${args.join(' ')} failed: ${result.stderr.trim()}`);
-  }
-  return result.stdout
-    .split('\n')
-    .map((line) => line.trim())
-    .filter(Boolean);
-}
-
-function scopePaths(values) {
-  if (
-    !Array.isArray(values) ||
-    values.some((value) => typeof value !== 'string' || !value.trim())
-  ) {
-    throw new Error('Invalid validation context paths.');
-  }
-  return [
-    ...new Set(
-      values.map((file) => {
-        const normalized = normalizePath(file);
-        if (
-          path.isAbsolute(normalized) ||
-          path.win32.isAbsolute(normalized) ||
-          /^[a-z]:/iu.test(normalized) ||
-          /[\r\n\0]/u.test(normalized) ||
-          normalized.split('/').includes('..') ||
-          normalized === '.'
-        ) {
-          throw new Error('Validation context path escapes the repository.');
-        }
-        return normalized.replace(/^\.\//u, '');
-      }),
-    ),
-  ].toSorted((left, right) => left.localeCompare(right));
-}
-
-function collectScope(
-  explicitPaths,
-  {
-    env = process.env,
-    git = gitLines,
-    exists = (file) => existsSync(path.join(REPO_ROOT, file)),
-  } = {},
-) {
-  if (explicitPaths.length > 0) {
-    const files = scopePaths(explicitPaths);
-    return {
-      baseRef: null,
-      deleted: files.filter((file) => !exists(file)),
-      empty: false,
-      files,
-      mode: 'explicit-paths',
-    };
-  }
-  const keys = [
-    'VIBE_HARNESS_VERIFY_PATHS',
-    'VIBE_HARNESS_VERIFY_BASE',
-    'VIBE_HARNESS_VERIFY_SCOPE',
-  ];
-  if (keys.some((key) => env[key] !== undefined)) {
-    if (!keys.every((key) => typeof env[key] === 'string')) {
-      throw new Error(
-        'Incomplete Harness validation context; refusing to recompute scope.',
-      );
-    }
-    let values;
-    try {
-      values = JSON.parse(env.VIBE_HARNESS_VERIFY_PATHS);
-    } catch {
-      throw new Error('Invalid Harness validation context JSON.');
-    }
-    const files = scopePaths(values);
-    const baseSha = env.VIBE_HARNESS_VERIFY_BASE;
-    const requestedScope = env.VIBE_HARNESS_VERIFY_SCOPE;
-    if (
-      !/^[a-f0-9]{40,64}$/u.test(baseSha) ||
-      !['affected', 'full', 'layer'].includes(requestedScope) ||
-      git(['rev-parse', '--verify', `${baseSha}^{commit}`])[0] !== baseSha
-    ) {
-      throw new Error('Invalid Harness validation context baseline or scope.');
-    }
-    return {
-      baseRef: baseSha,
-      baseSha,
-      requestedScope,
-      files,
-      deleted: files.filter((file) => !exists(file)),
-      empty: files.length === 0,
-      mode: 'harness-context',
-    };
-  }
-  const baseRef = 'origin/develop';
-  const [mergeBase] = git(['merge-base', 'HEAD', baseRef]);
-  if (!mergeBase) throw new Error(`Cannot resolve merge-base for ${baseRef}.`);
-  const files = [
-    ...git(['diff', '--name-only', mergeBase, '--']),
-    ...git(['ls-files', '--others', '--exclude-standard', '--full-name']),
-  ];
-  const deleted = git([
-    'diff',
-    '--name-only',
-    '--diff-filter=D',
-    mergeBase,
-    '--',
-  ]);
-  const uniqueFiles = [...new Set(files)].toSorted((left, right) =>
-    left.localeCompare(right),
-  );
-  return {
-    baseRef,
-    baseSha: mergeBase,
-    deleted: [...new Set(deleted)].toSorted((left, right) =>
-      left.localeCompare(right),
-    ),
-    empty: uniqueFiles.length === 0,
-    files: uniqueFiles,
-    mode: 'changed',
-  };
-}
-
-function normalizePath(file) {
-  return file.replaceAll('\\', '/');
-}
-
-function toFrontendPath(file) {
-  const normalized = normalizePath(file);
-  return normalized.startsWith('frontend/')
-    ? normalized.slice('frontend/'.length)
-    : normalized;
-}
-
-function toRepositoryPath(file) {
-  const normalized = normalizePath(file);
-  return normalized.startsWith('frontend/')
-    ? normalized
-    : `frontend/${normalized}`;
-}
-
-const DOC_PATTERN = /\.(?:md|mdx)$/u;
-const CONTRACT_FIXTURE_PATTERN = /^docs\/contracts\/.*\.json$/u;
-
-/**
- * 契约面路径前缀：API 定义、mock 数据与共享类型。命中时追加只读的
- * `mock:check:bridge-parity`（前后端桥接一致性），**不**自动运行写盘 codegen。
- */
-const CONTRACT_PREFIXES = Object.freeze([
-  'frontend/apps/mock-server/api/',
-  'frontend/apps/mock-server/mock-data/',
-  'frontend/apps/web/src/api/',
-  'frontend/packages/prototype-contracts/',
-]);
-
-function isContractPath(file) {
-  const normalized = normalizePath(file);
-  return CONTRACT_PREFIXES.some((prefix) => normalized.startsWith(prefix));
-}
-
-/**
- * 把变更路径分到前端、后端与文档桶；未识别的路径归入 `unknown`，由调用方按
- * 「无法界定 → 扩大范围」处理。
- */
-function classifyPaths(files) {
-  const buckets = {
-    backend: [],
-    contract: [],
-    deleted: [],
-    docs: [],
-    frontend: [],
-    unknown: [],
-  };
-  for (const file of files) {
-    const normalized = normalizePath(file);
-    if (normalized.startsWith('frontend/')) {
-      buckets.frontend.push(normalized);
-      // 契约面是前端的子集，单独成桶以便追加桥接一致性检查。
-      if (isContractPath(normalized)) buckets.contract.push(normalized);
-    } else if (normalized.startsWith('backend/'))
-      buckets.backend.push(normalized);
-    else if (CONTRACT_FIXTURE_PATTERN.test(normalized)) {
-      buckets.docs.push(normalized);
-      buckets.contract.push(normalized);
-    } else if (DOC_PATTERN.test(normalized)) buckets.docs.push(normalized);
-    else buckets.unknown.push(normalized);
-  }
-  return buckets;
-}
-
-/** 后端聚焦选择器：命中映射返回并集，未命中返回 null（= 完整后端单测）。 */
-function backendTestSelectors(backendPaths) {
-  const selectors = new Set();
-  let mapped = 0;
-  for (const file of backendPaths) {
-    const normalized = normalizePath(file);
-    for (const entry of BACKEND_TEST_MAPPING) {
-      if (entry.prefixes.some((prefix) => normalized.startsWith(prefix))) {
-        mapped += 1;
-        const actualTests = (directory) =>
-          readdirSync(path.join(BACKEND_ROOT, 'src/test/java', directory), {
-            withFileTypes: true,
-          }).flatMap((item) => {
-            if (item.isDirectory())
-              return actualTests(`${directory}/${item.name}`);
-            if (item.name.endsWith('Tests.java')) {
-              return [
-                `${directory}/${item.name}`
-                  .replace(/\.java$/u, '')
-                  .replaceAll('/', '.'),
-              ];
-            }
-            return [];
-          });
-        const selected = entry.testRoots
-          ? entry.testRoots.flatMap(actualTests)
-          : entry.selectors;
-        if (selected.length === 0)
-          throw new Error(`No tests in mapped domain: ${entry.domain}`);
-        for (const selector of selected) {
-          if (
-            !selector.includes('*') &&
-            !existsSync(
-              path.join(
-                BACKEND_ROOT,
-                'src/test/java',
-                `${selector.replaceAll('.', '/')}.java`,
-              ),
-            )
-          ) {
-            throw new Error(
-              `映射的测试尚未进入当前候选树：${selector}；请先合入对应测试，不可将部分选择当作通过。`,
-            );
-          }
-          selectors.add(selector);
-        }
-        break;
-      }
-    }
-  }
-  // A partial mapping cannot prove the unrecognised paths have no tests.
-  if (mapped !== backendPaths.length || selectors.size === 0) return null;
-  return [...selectors].toSorted((left, right) => left.localeCompare(right));
-}
-
-/** 失败现场只保留尾部：够定位 turbo/编译器的启动期错误，又不撑爆运行记录。 */
-const FAILURE_TAIL_CHARS = 4000;
-
-function validationCacheDirectory() {
-  return path.join(
-    process.env.VIBE_HARNESS_CACHE_DIR ||
-      path.join(REPO_ROOT, '.vibe-harness/cache'),
-    'turbo',
-  );
-}
-
-/** 检查实际包邻接关系；不安装依赖，也不修补共享 node_modules。 */
-function missingPackageDependencies(directory) {
-  const missing = [];
-  const visited = new Set();
-  const inspect = (current) => {
-    const actual = realpathSync(current);
-    if (visited.has(actual)) return;
-    visited.add(actual);
-    const manifestPath = path.join(actual, 'package.json');
-    const manifest = JSON.parse(readFileSync(manifestPath, 'utf8'));
-    const require = createRequire(manifestPath);
-    for (const [name, version] of Object.entries({
-      ...manifest.dependencies,
-      ...manifest.devDependencies,
-    })) {
-      const installed = require.resolve
-        .paths(name)
-        ?.map((lookup) => path.join(lookup, name))
-        .find((lookup) => existsSync(path.join(lookup, 'package.json')));
-      if (!installed) missing.push(`${manifest.name ?? current}: ${name}`);
-      else if (String(version).startsWith('workspace:')) inspect(installed);
-    }
-  };
-  inspect(directory);
-  return missing;
-}
-
-async function probeWritable(directory) {
-  await mkdir(directory, { recursive: true });
-  const file = path.join(directory, `.preflight-${randomUUID()}`);
-  const handle = await open(file, 'wx');
-  try {
-    await handle.writeFile('preflight');
-  } finally {
-    await handle.close();
-    await unlink(file);
-  }
-}
-
-async function preflightStages(stages, metadata) {
-  const frontend = stages.some((stage) => stage.command === 'bun');
-  const backend = stages.some((stage) => stage.maven);
-  const probe = (command, args) => {
-    const result = spawnSync(command, args, {
-      encoding: 'utf8',
-      shell: false,
-      stdio: 'pipe',
-      timeout: 5000,
-      windowsHide: true,
-    });
-    if (result.error || result.status !== 0)
-      throw new Error(`Toolchain unavailable: ${command}`);
-  };
-  if (frontend) {
-    probe('bun', ['--version']);
-    const directories = new Set([FRONTEND_ROOT]);
-    for (const file of metadata?.scope?.files ?? []) {
-      if (!file.startsWith('frontend/')) continue;
-      let directory = path.dirname(path.join(REPO_ROOT, file));
-      while (directory.startsWith(`${FRONTEND_ROOT}${path.sep}`)) {
-        if (existsSync(path.join(directory, 'package.json'))) {
-          directories.add(directory);
-          break;
-        }
-        directory = path.dirname(directory);
-      }
-    }
-    const missing = [...directories].flatMap((directory) =>
-      missingPackageDependencies(directory),
-    );
-    if (missing.length > 0)
-      throw new Error(
-        `Missing dependencies: ${missing.slice(0, 12).join(', ')}`,
-      );
-    await probeWritable(validationCacheDirectory());
-  }
-  if (backend) {
-    if (!existsSync(path.join(BACKEND_ROOT, MAVEN_WRAPPER)))
-      throw new Error('Maven Wrapper unavailable.');
-    const suffix = process.platform === 'win32' ? '.exe' : '';
-    for (const tool of ['java', 'javac']) {
-      probe(
-        process.env.JAVA_HOME
-          ? path.join(process.env.JAVA_HOME, 'bin', `${tool}${suffix}`)
-          : tool,
-        ['-version'],
-      );
-    }
-  }
-  await probeWritable(path.dirname(RUNS_PATH));
-}
-
-function teeStream(stream, name, sink) {
-  stream.setEncoding('utf8');
-  stream.on('data', (chunk) => {
-    sink.output = (sink.output + chunk).slice(-FAILURE_TAIL_CHARS);
-    (name === 'stderr' ? process.stderr : process.stdout).write(chunk);
-  });
-}
-
-function runCommand(command, args, cwd) {
-  return new Promise((resolve, reject) => {
-    const startedAt = Date.now();
-    const child = spawn(command, args, {
-      cwd,
-      env: {
-        ...process.env,
-        TURBO_CACHE_DIR: validationCacheDirectory(),
-      },
-      shell: false,
-      // Pipe + relay keeps the live console behavior of `inherit` while a tail
-      // of the output survives into the run record: the 2026-10 S5 turbo
-      // failures died in under a second and left no evidence behind.
-      stdio: ['inherit', 'pipe', 'pipe'],
-      windowsHide: true,
-    });
-    const stdoutTail = { output: '' };
-    const stderrTail = { output: '' };
-    if (child.stdout) teeStream(child.stdout, 'stdout', stdoutTail);
-    if (child.stderr) teeStream(child.stderr, 'stderr', stderrTail);
-    child.on('error', reject);
-    child.on('close', (exitCode) => {
-      resolve({
-        durationMs: Date.now() - startedAt,
-        exitCode: exitCode ?? 1,
-        stderrTail: stderrTail.output,
-        stdoutTail: stdoutTail.output,
-      });
-    });
-  });
-}
-
-/** Maven Wrapper 在 Windows 上是 .cmd，需要经 cmd.exe 解析。 */
-function runMaven(args) {
-  return process.platform === 'win32'
-    ? runCommand('cmd.exe', ['/d', '/c', MAVEN_WRAPPER, ...args], BACKEND_ROOT)
-    : runCommand(MAVEN_WRAPPER, args, BACKEND_ROOT);
-}
-
-async function runStages(
-  stages,
-  metadata,
-  {
-    prepare = preflightStages,
-    execute = (stage) =>
-      stage.maven
-        ? runMaven(stage.args)
-        : runCommand(stage.command, stage.args, stage.cwd),
-    record = writeRun,
-  } = {},
-) {
-  const results = [];
-  const preparationStartedAt = Date.now();
-  try {
-    await prepare(stages, metadata);
-  } catch (error) {
-    const run = {
-      ...metadata,
-      generatedAt: new Date().toISOString(),
-      status: 'blocked',
-      failureReason: error.message,
-      results: [
-        {
-          name: 'environment-preflight',
-          status: 'blocked',
-          exitCode: 2,
-          durationMs: Date.now() - preparationStartedAt,
-        },
-      ],
-    };
-    await record(run);
-    console.error(`[validation:summary] ${JSON.stringify(run)}`);
-    console.log(
-      `[VIBE_HARNESS_CHECK] ${JSON.stringify({ status: 'blocked', reason: 'environment-preflight-failed' })}`,
-    );
-    return 2;
-  }
-  const preparationMs = Date.now() - preparationStartedAt;
-  for (const stage of stages) {
-    console.warn(`[validation] ${stage.name} started (${stage.scope})`);
-    const started = Date.now();
-    const heartbeat = setInterval(() => {
-      console.warn(
-        `[validation:heartbeat] ${JSON.stringify({ stage: stage.name, scope: stage.scope, elapsedMs: Date.now() - started })}`,
-      );
-    }, 30_000);
-    heartbeat.unref();
-    let result;
-    try {
-      result = await execute(stage);
-    } finally {
-      clearInterval(heartbeat);
-    }
-    results.push({
-      cache: stage.cache ?? 'none',
-      durationMs: result.durationMs,
-      exitCode: result.exitCode,
-      name: stage.name,
-      scope: stage.scope,
-      ...(result.stderrTail?.trim()
-        ? { stderrTail: result.stderrTail.trim() }
-        : {}),
-    });
-    console.warn(
-      `[validation] ${stage.name} exit=${result.exitCode} durationMs=${result.durationMs}`,
-    );
-    if (result.exitCode !== 0) break;
-  }
-  const failed = results.find((item) => item.exitCode !== 0);
-  const run = {
-    generatedAt: new Date().toISOString(),
-    failureReason: failed
-      ? `${failed.name} exited ${failed.exitCode}${failed.stderrTail ? `: ${failed.stderrTail.slice(-600)}` : ''}`
-      : null,
-    lintTypecheckMs:
-      (results.find((item) => item.name === 'lint')?.durationMs ?? 0) +
-      (results.find((item) => item.name === 'typecheck')?.durationMs ?? 0),
-    results,
-    preparationMs,
-    ...metadata,
-  };
-  await record(run);
