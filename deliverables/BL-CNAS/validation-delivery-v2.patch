+    !standard &&
+    (buckets.backend.length > 0 || escalateBackend || unknownEscalates)
+  ) {
+    stages.push(
+      ...backendStages(buckets.backend, {
+        escalate: escalateBackend || unknownEscalates,
+      }),
+    );
+  }
+  if (standard && contractTouched) stages.push(CONTRACT_STANDARD_STAGE);
+  if (
+    standard &&
+    [...buckets.backend, ...deleted.backend].some((file) =>
+      file.startsWith('backend/src/main/resources/db/changelog/'),
+    )
+  )
