+import { readFileSync } from 'node:fs';
+import { parse as parseSfc } from '@vue/compiler-sfc';
+import { parse as parseTemplate } from '@vue/compiler-dom';
+
+import { describe, expect, it } from 'vitest';
+
+/**
+ * 传感器管理页的实时来源护栏（T5）。
+ *
+ * 页面行为依赖设施监控客户端与共享派生（运行期断言在
+ * `src/api/facility/telemetry.test.ts`）；本文件锁定页面自身必须保持的接线：
+ * 逐传感器来源只走 T1 的监控接口、控制动作按设施写权限门控、实时数据不落回
+ * 浏览器存储或本地 Mock，并且来源切换不写传感器台账。
+ */
+const PAGE = 'apps/web/src/views/facility/sensor-management.vue';
+const AREA_PAGE = 'apps/web/src/views/facility/area-management.vue';
+const AREA_SAFETY_FIELDS =
+  'apps/web/src/views/facility/_components/AreaSafetyReferencesFields.vue';
+const CERTIFICATE_FIELD =
+  'apps/web/src/views/facility/_components/SensorCalibrationCertificateField.vue';
+const SWITCH_START = 'async function confirmSourceSwitch';
+
+function pageSource() {
+  return readFileSync(PAGE, 'utf8');
+}
+
+function pageButtons() {
+  const template = parseSfc(pageSource()).descriptor.template?.content;
+  if (!template) throw new Error('sensor page has no template');
+  const buttons: any[] = [];
+  const visit = (node: any) => {
+    if (node.type === 1 && node.tag === 'ElButton') buttons.push(node);
+    for (const child of node.children ?? []) visit(child);
+  };
+  visit(parseTemplate(template));
+  return buttons;
+}
+
+function interpolationText(node: any): string {
+  if (node?.type === 5) return node.content.content.replace(/\s+/gu, '');
+  return (node?.children ?? []).map(interpolationText).join('');
+}
+
+function ifExpression(node: any): string {
+  return node?.props.find((prop: any) => prop.type === 7 && prop.name === 'if')?.exp?.content ?? '';
+}
+
+describe('传感器管理页实时来源（T5）', () => {
+  it('shows sensor names instead of internal UUIDs in the list', () => {
+    const source = pageSource();
+
+    expect(source).toContain(
+      'function sensorListName(sensor: Sensor): string {',
+    );
+    expect(source).toContain('sensor.code?.trim() ||');
+    expect(source).toContain('sensor.serialNumber.trim() ||');
+    expect(source).toContain("'未命名传感器'");
+    expect(source).toContain('{{ sensorListName(sensorRow(row)) }}');
+    expect(source).not.toContain('{{ row.id }} · {{ row.name }}');
+  });
+
+  it('shows activation for draft sensors while keeping close hidden', () => {
+    const buttons = pageButtons();
+    const actionButton = buttons.find((node) =>
+      interpolationText(node).includes('actionLabels[suggestedAction(sensorRow(row))]'));
+    expect(actionButton).toBeDefined();
+    expect(ifExpression(actionButton).replace(/\s+/gu, '')).toMatch(
+      /suggestedAction\(sensorRow\(row\)\)!==['"]bind_monitoring_point['"]/u,
+    );
+    expect(ifExpression(actionButton).replace(/\s+/gu, '')).not.toMatch(/row\.status!==['"]DRAFT['"]/u);
+    const closeButton = buttons.find((node) => /['"]重开['"]/u.test(interpolationText(node)));
+    expect(ifExpression(closeButton).replace(/\s+/gu, '')).toMatch(/row\.status!==['"]DRAFT['"]/u);
+    expect(interpolationText(closeButton)).toMatch(/row\.status===['"]CLOSED['"]\?['"]重开['"]:['"]关闭['"]/u);
+  });
+
+  it('does not show redundant certificate guidance above the form', () => {
+    expect(pageSource()).not.toContain(
+      '正式主档支持编码、名称、型号、序列号、所属区域、校准证书附件与到期日。启用前必须存在可用的设施域受控证书附件，且到期日不得早于当天。',
+    );
+    expect(readFileSync(CERTIFICATE_FIELD, 'utf8')).not.toContain(
+      '证书作为受控附件保存；保存传感器时服务端会复核文件仍可用。',
+    );
+  });
+
+  it('uses a controlled certificate attachment for activation and editing', () => {
+    const source = pageSource();
+
+    expect(source).toContain('SensorCalibrationCertificateField');
+    expect(source).toContain(
+      'if (!sensor.calibrationCertificateAttachment) return false;',
+    );
+    expect(source).toContain(
+      'v-model:certificate="draftForm.calibrationCertificateAttachment"',
+    );
+    expect(source).not.toContain('v-model="draftForm.calibrationCertificate"');
+    expect(source).not.toContain('校准证书和扩展属性尚未接入');
+    expect(source).not.toContain('请上传受控的校准证书附件');
+  });
+
+  it('offers communication methods from a select with a legacy-friendly value', () => {
+    const source = pageSource();
+    const areaSource = readFileSync(AREA_PAGE, 'utf8');
+    expect(source).toContain('SENSOR_COMMUNICATION_OPTIONS');
+    expect(source).toContain('<ElSelect');
+    expect(source).toContain('allow-create');
+    expect(source).not.toContain('placeholder="例如：LoRaWAN、MQTT"');
+    expect(areaSource).toContain('SENSOR_COMMUNICATION_OPTIONS');
+    expect(areaSource).toContain('v-model="assetForm.communication"');
+  });
+
+  it('removes the obsolete new-area floor-plan hint', () => {
+    const source = readFileSync(AREA_SAFETY_FIELDS, 'utf8');
+    expect(source).not.toContain('新建区域提交成功后可回到编辑页');
+  });
+
+  it('reads and switches the per-sensor source through the T1 monitoring client', () => {
+    const source = pageSource();
+
+    expect(source).toContain('listFacilityMonitoringAssetsApi');
+    expect(source).toContain('setFacilityMonitoringSourceApi');
+    expect(source).toContain('resolveFacilityPointTelemetryCell');
+    expect(source).toContain('facilityMonitoringAssetId');
+    expect(source).toContain('indexFacilityMonitoringAssets');
+  });
+
+  it('gates every source switch behind the facility write permission', () => {
+    const source = pageSource();
+
+    expect(source).toContain("hasAccessByCodes(['Facility:Edit'])");
+    expect(source).toContain('canOperateFacilityMonitoring');
+    expect(source).toContain('v-if="canControlTelemetry"');
+  });
+
+  it('keeps source switching out of the sensor ledger commands', () => {
+    const source = pageSource();
+    const start = source.indexOf(SWITCH_START);
+    expect(start).toBeGreaterThan(-1);
+    const rest = source.slice(start);
+    const end = rest.indexOf('\n}\n');
+    const switchBody = rest.slice(0, end === -1 ? rest.length : end);
+
+    expect(switchBody).toContain('setFacilityMonitoringSourceApi');
+    // 采样来源切换绝不改动传感器档案：版本、校准、断联与生命周期不受影响。
+    expect(switchBody).not.toContain('commandSensorApi');
+  });
+
+  it('never falls back to browser storage for real-time source truth', () => {
+    expect(pageSource()).not.toMatch(/localStorage|sessionStorage/u);
+  });
+
+  it('shows source, run state, reading and heartbeat per sensor', () => {
+    const source = pageSource();
+
+    expect(source).toContain('data-testid="sensor-telemetry-column"');
+    expect(source).toContain('sourceLabel');
+    expect(source).toContain('stateLabel');
+    expect(source).toContain('heartbeatAt');
+    expect(source).toContain('telemetryValueText');
+  });
+
+  it('shows the effective published binding as a read-only sensor source', () => {
+    const source = pageSource();
+
+    expect(source).toContain('effectiveSensorBinding(selected)');
+    expect(source).toContain('effectiveSensorBindings(sensor)');
+    expect(source).toContain('if (formalMode) delete payload.externalCode;');
+    expect(source).toContain('由采集通道发布的点位映射维护');
+    expect(source).toContain('sensorExternalCodeText(sensorRow(row))');
+    expect(source).toContain('sensorExternalCodeText(selected)');
+    expect(source).toContain(
+      'bindingRoleLabel(effectiveSensorBinding(selected)!.sourceRole)',
+    );
+    expect(source).toContain(
+      '<ElFormItem v-if="!formalMode" label="外部点位编码"',
+    );
+    expect(source).not.toContain('credentialRef');
+    expect(source).not.toMatch(/mqtts?:\/\//u);
+    expect(source).not.toMatch(/https:\/\//u);
+    expect(source).not.toContain('effectiveSensorBinding(sensor: Sensor)');
+  });
+
+  it('clears the real-time column when the monitoring read fails', () => {
+    const source = pageSource();
+
+    expect(source).toContain('telemetryError');
+    expect(source).toContain('telemetryViews.value = new Map()');
+  });
+
+  it('registers calibration against the selected channel and controlled certificate', () => {
+    const source = pageSource();
+
+    expect(source).toContain('listSensorChannelCalibrationsApi');
+    expect(source).toContain('createSensorChannelCalibrationApi');
+    expect(source).toContain('calibrationDraft.certificate?.storageId');
+    expect(source).toContain(
+      'v-model:certificate="calibrationDraft.certificate"',
+    );
+    expect(source).toContain('绑定不代表校准有效');
+  });
+
+  it('requires a reviewed dry-run before executing legacy backfill', () => {
+    const source = pageSource();
+
+    expect(source).toContain('previewMonitoringBackfillApi');
+    expect(source).toContain('executeMonitoringBackfillApi');
+    expect(source).toContain('fingerprint: preview.fingerprint');
+    expect(source).toContain('backfillConfirmed');
+    expect(source).toContain('旧关系迁移');
+  });
+});
