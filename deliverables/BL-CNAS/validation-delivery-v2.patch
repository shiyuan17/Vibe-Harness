+  'DM8_APP_USERNAME',
+  'DM8_APP_PASSWORD',
+  'DM8_MIGRATOR_USERNAME',
+  'DM8_MIGRATOR_PASSWORD',
+]);
+
+/** 供档位配置引用的原子模式；DM8 集成在没有环境时明确报 blocked 而不是假通过。 */
+async function runBackendMode(mode) {
