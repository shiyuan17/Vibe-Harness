+  // Windows 的单条命令行上限约 8k 字符；变更面较大时按长度分片，避免 related 调用
+  // 直接 E2BIG 失败。分片只影响调用次数，不改变「以模块图选集」的语义。
+  const chunks = chunkByLength(sources, MAX_ARG_CHARS);
+  const estimate = await staticEstimate(sources);
+  console.warn(
+    `[test:changed] ${label}：related 输入 ${sources.length} 个源文件，静态下限 ${estimate.length} 个测试文件；模块图为实际选择依据。`,
+  );
+  const relatedResults = [];
+  let emptySelection = false;
+  for (const chunk of chunks) {
+    const related = await runVitest(relatedArgs(group, chunk, passthrough));
+    relay(related);
+    relatedResults.push(related);
+    // `vitest related` 选不中用例时退出码是 0（“No test files found”），这正是
+    // 需要拦下的假通过：先看输出，再看退出码。
+    if (NO_TESTS_PATTERN.test(`${related.stdout}${related.stderr}`)) {
+      emptySelection = true;
+    }
+  }
+  const relatedMs = relatedResults.reduce(
+    (total, item) => total + item.durationMs,
+    0,
+  );
+  if (emptySelection) {
+    const affected = affectedDomainTests(
+      sources,
+      await listFrontendFiles(),
+      group,
+    );
+    if (affected.length === 0) {
+      console.error(
+        `[test:changed] ${label}：related 空选择且受影响域无测试；覆盖缺口，检查失败。`,
+      );
+      return {
+        durationMs: relatedMs,
+        exitCode: 1,
+        mode: 'coverage-gap',
+        reason: '相关测试及受影响域测试均为空',
+        selectedFiles: 0,
+      };
+    }
+    console.warn(
+      `[test:changed] ${label}：related 空选择（覆盖缺口），扩大到受影响域 ${affected.length} 个测试文件。`,
+    );
+    const fallback = await runVitest([
+      'run',
+      ...affected,
+      ...(GROUPS[group].configPath
+        ? ['--config', GROUPS[group].configPath]
+        : ['--dom']),
+      ...passthrough,
+    ]);
+    relay(fallback);
+    return {
+      durationMs: relatedMs + fallback.durationMs,
+      exitCode: fallback.code,
+      mode: 'domain',
+      reason: 'vitest related 未选中用例',
+      selectedFiles: affected.length,
+    };
+  }
+  const failed = relatedResults.find((item) => item.code !== 0);
+  return {
+    durationMs: relatedMs,
+    exitCode: failed ? failed.code : 0,
+    mode: 'related',
+    reason: null,
+    selectedFilesLowerBound: estimate.length,
+  };
+}
+
+async function missingExplicitPaths(sources) {
+  const missing = [];
+  for (const source of sources) {
+    try {
+      await stat(path.join(FRONTEND_ROOT, source));
+    } catch {
+      missing.push(source);
+    }
+  }
+  return missing;
+}
+
+function groupReasonsFor(reasons, group) {
+  return reasons
+    .filter((reason) => reason.group === 'all' || reason.group === group)
+    .map((reason) => reason.text);
+}
+
+async function main() {
+  const options = parseArgs(process.argv.slice(2));
+  let scopeLabel;
+  let changedFiles;
+  let deletedFiles;
+  if (options.paths.length > 0) {
+    scopeLabel = `显式路径（${options.paths.length} 个输入）`;
+    changedFiles = [...options.paths];
+    deletedFiles = [];
+  } else {
+    const mergeBase = await resolveMergeBase(options.baseRef);
+    scopeLabel = `${options.baseRef}（merge-base ${mergeBase.slice(0, 9)}）`;
+    changedFiles = await collectChangedFiles(mergeBase);
+    deletedFiles = await collectDeletedFiles(mergeBase);
+  }
+
+  let allSources = toFrontendSources(changedFiles);
+  /*
+   * `--paths` 是人工输入，路径打错属于调用错误，必须显式报错；
+   * 变更集里被删除的源文件同样解析不出文件，但那是正常的重构结果：
+   * 它已由 `escalationReasons` 按分组触发「回退完整集合」，不能在此直接中断
+   * （否则任何删除源文件的改动都无法运行本检查）。
+   */
+  if (options.paths.length > 0) {
+    const missing = await missingExplicitPaths(allSources);
+    if (missing.length > 0) {
+      const base = process.env.VIBE_HARNESS_VERIFY_BASE;
+      for (const file of missing) {
+        if (!base || !/^[a-f0-9]{40,64}$/u.test(base)
+          || (await gitLines(['ls-tree', '--name-only', base, '--', `frontend/${file}`])).length === 0) {
+          throw new Error(`Missing explicit input is not a proven baseline deletion: ${file}`);
+        }
+        if (pageContractTests([file]).length === 0) throw new Error(`Deleted input dependency coverage gap: ${file}`);
+      }
+      allSources = [...new Set([...allSources.filter((file) => !missing.includes(file)), ...pageContractTests(missing)])];
+    }
+  } else {
+    const removed = toFrontendSources(deletedFiles).filter((file) => !isTestFile(file));
+    if (removed.some((file) => !pageContractTests([file]).length)) throw new Error('Deleted input dependency coverage gap; map baseline consumers before running');
+    allSources = [...new Set([...allSources.filter((file) => !removed.includes(file)), ...pageContractTests(removed)])];
+  }
+  const frontendChanged = changedFiles.filter(
+    (file) => toFrontendRelative(file) !== null,
+  );
+  if (frontendChanged.length === 0) {
+    console.error(
+      `[test:changed] 范围：${scopeLabel}；无前端变更，空选择不构成通过。`,
+    );
+    process.exitCode = 1;
+    return;
+  }
+  const reasons = escalationReasons({
+    changedFiles: frontendChanged,
+    deletedFiles,
+    hasSources: allSources.length > 0,
+  });
+  const byGroup = { mock: [], web: [] };
+  for (const source of allSources) byGroup[groupOf(source)].push(source);
+
+  if (options.dryRun) {
+    const estimate = await staticEstimate(allSources);
+    console.warn(
+      `[test:changed] 范围：${scopeLabel}；${allSources.length} 个前端源文件。`,
+    );
+    console.warn(
+      `[test:changed] 计划：web ${byGroup.web.length} / mock+contracts ${byGroup.mock.length} 个源文件；实际选择由 vitest related 模块图决定。`,
+    );
+    for (const reason of reasons) {
+      console.warn(
+        `[test:changed] 回退完整集合（${reason.group}）：${reason.text}`,
+      );
+    }
+    console.warn(
+      `[test:changed] 静态估算（不含传递依赖，仅下限）：${estimate.length} 个测试文件`,
+    );
+    for (const file of estimate) console.warn(`  test ${file}`);
+    return;
+  }
+
+  const startedAt = Date.now();
+  const results = [];
+  for (const group of ['web', 'mock']) {
+    const groupSources = byGroup[group];
+    const groupReasons = groupReasonsFor(reasons, group);
+    if (groupSources.length === 0 && groupReasons.length === 0) continue;
+    const outcome = await runGroup(group, {
+      escalateBecause: groupReasons.length > 0 ? groupReasons.join('；') : null,
+      passthrough: options.passthrough,
+      sources: groupSources,
+    });
+    results.push({ group, ...outcome });
+    if (outcome.exitCode !== 0) process.exitCode = outcome.exitCode;
+  }
+  if (results.length === 0) {
+    console.error('[test:changed] 没有选中任何前端检查；覆盖缺口，检查失败。');
+    process.exitCode = 1;
+  }
+
+  console.warn(
+    `[validation:selection] ${JSON.stringify({
+      durationMs: Date.now() - startedAt,
+      groups: results,
+      mode: 'vitest-related',
+      reasons: reasons.map((reason) => reason.text),
+      scope: scopeLabel,
+      sources: allSources.length,
+    })}`,
+  );
+}
+
+if (
+  process.argv[1] &&
+  path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)
+) {
+  main().catch((error) => {
+    console.error(
+      `[test:changed] failed: ${error instanceof Error ? error.message : error}`,
+    );
+    process.exitCode = 1;
+  });
+}
+
+export {
+  affectedDomainTests,
+  chunkByLength,
+  collectChangedFiles,
+  escalationReasons,
+  groupOf,
+  isTestFile,
+  parseArgs,
+  pageContractTests,
+  staticEstimate,
+  toFrontendRelative,
+  toFrontendSources,
+};
