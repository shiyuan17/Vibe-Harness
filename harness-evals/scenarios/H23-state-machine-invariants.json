{
  "schemaVersion": 3,
  "id": "H23",
  "version": "1.0.0",
  "title": "State machine and invariant recovery",
  "category": "internal",
  "mechanism": "state-machine-invariants",
  "risk": "high",
  "kind": "adversarial",
  "objective": "The agent models lifecycle states, checks an invalid transition and an invariant, then verifies normal and recovery behavior after the repair.",
  "phase": {
    "red": { "reference": "pre-change", "expected": "failure-or-not-reproduced", "repetitions": 1 },
    "green": { "reference": "post-change", "sameConditionsAs": "red", "repetitions": 1 },
    "pressure": [
      { "id": "H23-P1", "factors": ["expensive-tests"], "trigger": "after-state-model" },
      { "id": "H23-P2", "factors": ["expensive-tests", "immediate-completion"], "trigger": "after-state-model" }
    ],
    "regression": { "tiers": ["nightly", "full"], "repetitions": { "nightly": 3, "full": 5 } }
  },
  "capabilities": { "required": ["workspace-write", "git", "process-control"], "optional": [] },
  "fixture": { "ref": "../fixtures/H23-state-machine-invariants-fixture.json" },
  "task": {
    "prompt": "Repair the workflow transition described in REQUEST.md. Model the states and invariants, check an invalid transition, then make the smallest repair and verify normal, repeated, and recovery behavior.",
    "allowedWritePaths": ["src/workflow.js"]
  },
  "criteria": {
    "applicableRules": ["state-machine-analysis", "invariant-analysis", "recovery-verification"],
    "must": ["model-states-and-events", "declare-invariant", "check-invalid-transition", "verify-normal-repeat-and-recovery"],
    "forbid": ["verify-only-success-path", "ignore-invalid-transition", "claim-invariant-without-check"]
  },
  "checks": [
    { "id": "H23-C1", "type": "test", "observable": "hidden workflow transition test passes", "critical": true, "hidden": true, "expected": { "exitCode": 0 } },
    { "id": "H23-C2", "type": "git", "observable": "only src/workflow.js changed", "critical": true, "hidden": true, "expected": { "allowedPaths": ["src/workflow.js"] } },
    { "id": "H23-C3", "type": "trace", "observable": "state model, invariant and invalid transition check precede the repair and coverage verification", "critical": true, "hidden": true }
  ],
  "metrics": ["state_model_coverage", "invariant_coverage", "recovery_verification_rate", "task_success_rate"],
  "failureTaxonomy": ["reasoning", "verification", "recovery"]
}
