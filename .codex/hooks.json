{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Github/JW/LoopEngine/.agents/cognis/hooks/codex-hook.mjs\" --expected-event SessionStart",
            "commandWindows": "node \"D:/Github/JW/LoopEngine/.agents/cognis/hooks/codex-hook.mjs\" --expected-event SessionStart",
            "timeout": 10,
            "statusMessage": "Loading Cognis project context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Github/JW/LoopEngine/.agents/cognis/hooks/codex-hook.mjs\" --expected-event UserPromptSubmit",
            "commandWindows": "node \"D:/Github/JW/LoopEngine/.agents/cognis/hooks/codex-hook.mjs\" --expected-event UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
