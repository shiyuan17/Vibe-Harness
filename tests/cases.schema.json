{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe-Harness 用例台账",
  "description": "本仓库自用的逐用例台账；tests/ 不进入 pack，因此该文件不随安装分发。",
  "type": "object",
  "required": ["schemaVersion", "layers", "cases"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "layers": {
      "type": "array",
      "items": { "type": "string", "enum": ["unit", "component", "integration", "e2e", "matrix"] },
      "minItems": 5,
      "maxItems": 5
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "layer", "file", "ordinal", "name", "legacy", "risk", "owner", "source", "status", "addedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[UCIEM]-[A-Za-z0-9._-]+-[0-9]{3}$" },
          "layer": { "type": "string", "enum": ["unit", "component", "integration", "e2e", "matrix"] },
          "file": { "type": "string", "pattern": "^tests/(unit|component|integration|e2e|matrix)/[A-Za-z0-9._-]+\\.test\\.js$" },
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 999 },
          "name": { "type": "string", "minLength": 1 },
          "legacy": { "type": "boolean" },
          "risk": { "type": "string", "enum": ["low", "standard", "high"] },
          "owner": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["migration", "declared"] },
          "status": { "type": "string", "enum": ["active", "quarantined", "retired"] },
          "techDebtId": { "type": "string", "pattern": "^TD-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+$" },
          "addedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
