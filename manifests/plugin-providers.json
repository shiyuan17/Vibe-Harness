{
  "schemaVersion": 1,
  "capabilities": [
    {
      "id": "browser.devtools",
      "description": "通过开发者工具能力检查和控制浏览器。"
    },
    {
      "id": "browser.automation",
      "description": "通过项目本地浏览器运行时自动化浏览器交互。"
    },
    {
      "id": "code-review.automated",
      "description": "对项目变更运行自动化代码评审提供方。"
    },
    {
      "id": "work-management.read-write",
      "description": "通过远端提供方读取和修改工作管理数据。"
    },
    {
      "id": "work-management.read-only",
      "description": "通过受限的远端提供方只读工作管理数据。"
    }
  ],
  "providers": [
    {
      "id": "chrome-devtools",
      "cliName": "chrome-devtools-mcp",
      "aliases": [
        "chrome-devtools-mcp",
        "chrome-devtools"
      ],
      "moduleId": "chrome-devtools",
      "capabilities": [
        "browser.devtools"
      ],
      "transport": "local-mcp",
      "selection": {
        "includeInAll": true,
        "allowInProjectConfig": true
      },
      "provisioningToolId": "chromeDevtoolsMcp"
    },
    {
      "id": "playwright",
      "cliName": "playwright-cli",
      "aliases": [
        "playwright-cli",
        "playwright"
      ],
      "moduleId": "playwright",
      "capabilities": [
        "browser.automation"
      ],
      "transport": "cli",
      "selection": {
        "includeInAll": true,
        "allowInProjectConfig": true
      },
      "provisioningToolId": "playwrightCli"
    },
    {
      "id": "open-code-review",
      "cliName": "open-code-review",
      "aliases": [
        "open-code-review"
      ],
      "moduleId": "open-code-review",
      "capabilities": [
        "code-review.automated"
      ],
      "transport": "cli",
      "selection": {
        "includeInAll": true,
        "allowInProjectConfig": true
      },
      "provisioningToolId": "openCodeReview"
    },
    {
      "id": "linear",
      "cliName": "linear-mcp",
      "aliases": [
        "linear-mcp",
        "linear"
      ],
      "moduleId": "linear",
      "capabilities": [
        "work-management.read-write"
      ],
      "transport": "remote-mcp",
      "selection": {
        "includeInAll": false,
        "allowInProjectConfig": false
      },
      "conflicts": [
        "linear-readonly"
      ]
    },
    {
      "id": "linear-readonly",
      "cliName": "linear-mcp-readonly",
      "aliases": [
        "linear-mcp-readonly",
        "linear-readonly"
      ],
      "moduleId": "linear-readonly",
      "capabilities": [
        "work-management.read-only"
      ],
      "transport": "remote-mcp",
      "selection": {
        "includeInAll": false,
        "allowInProjectConfig": false
      },
      "conflicts": [
        "linear"
      ]
    }
  ]
}
