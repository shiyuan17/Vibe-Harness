{
  "PreToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "{{hookBootstrapCommand}} --host qoder --expected-event PreToolUse",
          "timeout": 10,
          "statusMessage": "Vibe-Harness safety policy"
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{hookBootstrapCommand}} --host qoder --expected-event PermissionRequest",
          "timeout": 10,
          "statusMessage": "Vibe-Harness safety policy"
        }
      ]
    }
  ]
}
