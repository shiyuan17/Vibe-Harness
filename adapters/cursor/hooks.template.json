{
  "preToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{hookRunnerPath}}\" --host cursor --expected-event preToolUse",
          "timeout": 10,
          "statusMessage": "Vibe-Harness safety policy"
        }
      ]
    }
  ]
}
