{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{hookBootstrapCommand}} --expected-event PermissionRequest",
            "commandWindows": "{{hookBootstrapCommand}} --expected-event PermissionRequest",
            "timeout": 10,
            "statusMessage": "Checking Vibe-Harness safety policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "{{hookBootstrapCommand}} --expected-event PreToolUse",
            "commandWindows": "{{hookBootstrapCommand}} --expected-event PreToolUse",
            "timeout": 10,
            "statusMessage": "Checking Vibe-Harness safety policy"
          }
        ]
      }
    ]
  }
}
