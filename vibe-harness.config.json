{
  "projectName": "Vibe-Harness",
  "forbiddenProjectTerms": [
    "SYBaseProjectWeb",
    "SYBaseProject",
    "病理",
    "localhost:5777"
  ],
  "language": "zh-CN",
  "packageManager": "pnpm",
  "profile": "full",
  "modules": [
    "agents",
    "rules",
    "templates",
    "skills",
    "schemas",
    "evals",
    "memory",
    "hooks",
    "roles",
    "project-scripts"
  ],
  "roles": {
    "enabled": true
  },
  "validationCommands": {
    "lint": "pnpm lint",
    "typecheck": "pnpm typecheck",
    "test": "pnpm test:unit",
    "eval": "pnpm eval:replay",
    "tiers": {
      "quick": [
        "pnpm lint",
        "pnpm typecheck",
        "pnpm test:unit"
      ],
      "standard": [
        "pnpm test:component",
        "pnpm test:integration"
      ],
      "deep": [
        "pnpm eval:replay",
        "pnpm test:e2e",
        "pnpm test:matrix",
        "pnpm smoke:lifecycle"
      ]
    }
  },
  "verification": {
    "timeoutMs": 600000
  },
  "evaluations": {
    "enabled": true,
    "suites": [
      "evals/suites/vibe-harness-core.json"
    ],
    "reference": "evals/references/vibe-harness-core.offline.json",
    "thresholds": {
      "criticalPassRate": 1,
      "overallScore": 0.9,
      "maxCapabilityRegression": 0.05
    },
    "onlineRunner": null,
    "repetitions": 3
  },
  "hooks": {
    "redZonePaths": [
      ".env",
      "auth/",
      "ci/cd/",
      ".github/workflows/",
      ".codex/hooks.json",
      ".cursor/hooks.json",
      ".cursor/mcp.json",
      ".mcp.json",
      ".qoder/settings.json",
      ".zcode/config.json"
    ]
  },
  "riskZones": {
    "red": [
      "auth",
      "secrets",
      "ci-cd",
      "env"
    ],
    "yellow": [
      "shared-libs",
      "state",
      "routing",
      "io-clients"
    ]
  },
  "crossRepo": {
    "enabled": false,
    "backendRepo": ""
  },
  "projectRules": {
    "mode": "auto",
    "overrides": {}
  },
  "clarification": {
    "posture": "balanced"
  },
  "memory": {
    "enabled": true,
    "path": ".agents/memory"
  },
  "targets": [
    "codex"
  ]
}
