{
  "projectName": "MinimalProject",
  "language": "zh-CN",
  "packageManager": "pnpm",
  "target": "codex",
  "profile": "minimal",
  "validationCommands": {
    "lint": "pnpm lint",
    "typecheck": "pnpm check:type",
    "governance": "pnpm run check:governance"
  },
  "riskZones": {
    "red": ["auth", "global request layer", "ci/cd", "env"],
    "yellow": ["shared components", "stores", "routing", "request clients"]
  },
  "crossRepo": {
    "enabled": false,
    "backendRepo": ""
  }
}
