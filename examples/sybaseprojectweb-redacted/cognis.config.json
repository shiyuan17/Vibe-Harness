{
  "projectName": "SourceProjectExample",
  "language": "zh-CN",
  "packageManager": "pnpm",
  "target": "codex",
  "profile": "core",
  "validationCommands": {
    "lint": "pnpm lint",
    "typecheck": "pnpm check:type"
  },
  "riskZones": {
    "red": ["auth", "secrets", "ci-cd", "env"],
    "yellow": ["shared-libs", "state", "routing", "io-clients"]
  },
  "crossRepo": {
    "enabled": true,
    "backendRepo": "../BackendProject"
  }
}
